.MODEL SMALL
.STACK 100H

.DATA

; =========================================================
; [MEMBER 2 WORK] - DATA DECLARATIONS
; =========================================================
    MAX_PRINCIPAL   EQU 9999D     ; 本金上限 RM 9999
    MAX_RATE        EQU 99D       ; 利率上限 99%
    MAX_TENURE      EQU 99D       ; 期限上限 99个月

    PRINCIPAL       DW 0          ; 本金 (RM)
    RATE            DW 0          ; 年利率 (%)
    TENURE_MONTHS   DW 0          ; 存款期限 (月)
    SIMPLE_INTEREST DW 0          ; [功能1] 单利利息整数部分
    INT_REM         DW 0          ; 单利利息余数 (用于算小数)
    TOTAL_MATURITY  DW 0          ; [功能2] 到期总额

    ; Member 2 输入提示与错误信息
    STR_P       DB 0DH, 0AH, "ENTER PRINCIPAL AMOUNT (RM 1-9999): $"
    STR_R       DB 0DH, 0AH, "ENTER ANNUAL RATE % (1-99): $"
    STR_M       DB 0DH, 0AH, "ENTER TENURE IN MONTHS (1-99): $"
    STR_ERR     DB 0DH, 0AH, "INVALID INPUT OR OUT OF RANGE! PLEASE TRY AGAIN.$"


; =========================================================
; [MEMBER 3 WORK] - DATA DECLARATIONS
; =========================================================
    TAX_DEDUCTION   DW 0          ; [功能3] 扣税 10%
    MONTHLY_PAYOUT  DW 0          ; [功能4] 每月预估收益

    TITLE_BM    DB 0DH, 0AH, "========================================"
                DB 0DH, 0AH, "      BANK ACCOUNT SUMMARY REPORT       "
                DB 0DH, 0AH, "========================================$"
    RPT_P       DB 0DH, 0AH, "  PRINCIPAL AMOUNT : RM $"
    RPT_R       DB 0DH, 0AH, "  ANNUAL RATE (%)  : $"
    RPT_M       DB 0DH, 0AH, "  TENURE (MONTHS)  : $"
    RPT_F1      DB 0DH, 0AH, "  TOTAL INTEREST   : RM $"
    RPT_F2      DB 0DH, 0AH, "  TOTAL AT MATURITY: RM $"
    RPT_F3      DB 0DH, 0AH, "  TAX DEDUCTION(10%): RM $"
    RPT_F4      DB 0DH, 0AH, "  MONTHLY PAYOUT   : RM $"
    NL          DB 0DH, 0AH, "$"

    DIGITS      DB 6 DUP(?)

.CODE

; =========================================================
; MAIN PROC
; =========================================================
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    ; 1. Member 2 输入模块
    CALL M2_INPUT_DATA_PROC

    ; 2. Member 2 计算功能 1 & 2
    CALL M2_CALC_SIMPLE_INTEREST_PROC
    CALL M2_CALC_TOTAL_MATURITY_PROC

    ; 3. Member 3 计算功能 3 & 4
    CALL M3_CALC_ADVANCED_PROC

    ; 4. 显示带有小数点的 Summary Report
    CALL M3_DISPLAY_SUMMARY_PROC

    MOV AX, 4C00H
    INT 21H
MAIN ENDP


; =========================================================
; [MEMBER 2 WORK] - MODULE 1: DATA ENTRY WITH VALIDATION
; =========================================================
M2_INPUT_DATA_PROC PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

GET_P:
    MOV AH, 09H
    LEA DX, STR_P
    INT 21H
    
    MOV CX, 1              ; Min = 1
    MOV DX, MAX_PRINCIPAL  ; Max = 9999
    CALL M2_READ_NUM_RANGE
    JC ERR_P
    MOV PRINCIPAL, AX
    JMP GET_R

ERR_P:
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    JMP GET_P

GET_R:
    MOV AH, 09H
    LEA DX, STR_R
    INT 21H
    
    MOV CX, 1              ; Min = 1
    MOV DX, MAX_RATE       ; Max = 99
    CALL M2_READ_NUM_RANGE
    JC ERR_R
    MOV RATE, AX
    JMP GET_M

ERR_R:
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    JMP GET_R

GET_M:
    MOV AH, 09H
    LEA DX, STR_M
    INT 21H
    
    MOV CX, 1              ; Min = 1
    MOV DX, MAX_TENURE     ; Max = 99
    CALL M2_READ_NUM_RANGE
    JC ERR_M
    MOV TENURE_MONTHS, AX
    JMP INPUT_DONE

ERR_M:
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    JMP GET_M

INPUT_DONE:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
M2_INPUT_DATA_PROC ENDP


; ---------------------------------------------------------
; [MEMBER 2 WORK] - READ_NUM_RANGE (通用整数校验)
; ---------------------------------------------------------
M2_READ_NUM_RANGE PROC
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI

    MOV SI, CX
    MOV DI, DX
    MOV BX, 0
    MOV CX, 0

READ_CHAR_LOOP:
    MOV AH, 01H           ; 单字符带回显 (Chapter 4)
    INT 21H

    CMP AL, 0DH           ; Enter 键
    JE CHECK_RANGE

    CMP AL, '0'
    JB INPUT_ERROR
    CMP AL, '9'
    JA INPUT_ERROR

    SUB AL, '0'
    MOV AH, 0
    PUSH AX

    MOV AX, BX
    MOV DX, 10D
    MUL DX
    JC POP_AND_ERR

    POP DX
    ADD AX, DX
    JC INPUT_ERROR

    MOV BX, AX
    INC CX
    JMP READ_CHAR_LOOP

POP_AND_ERR:
    POP AX

INPUT_ERROR:
    STC                   ; CF = 1 失败
    JMP RANGE_EXIT

CHECK_RANGE:
    CMP CX, 0
    JE INPUT_ERROR

    CMP BX, SI
    JB INPUT_ERROR
    CMP BX, DI
    JA INPUT_ERROR

    MOV AX, BX
    CLC                   ; CF = 0 成功

RANGE_EXIT:
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
M2_READ_NUM_RANGE ENDP


; =========================================================
; [MEMBER 2 WORK] - CALCULATION FUNCTIONS 1 & 2
; =========================================================

; ---------------------------------------------------------
; [MEMBER 2 WORK] - 功能 1: 单利计算 (算商与余数)
; ---------------------------------------------------------
M2_CALC_SIMPLE_INTEREST_PROC PROC
    PUSH AX
    PUSH BX
    PUSH DX

    MOV AX, PRINCIPAL
    MOV BX, RATE
    MUL BX                ; DX:AX = P * R

    MOV BX, TENURE_MONTHS
    MUL BX                ; DX:AX = (P * R) * M

    MOV BX, 1200D
    DIV BX                ; AX = 商 (利息整数), DX = 余数 (用于计算小数)

    MOV SIMPLE_INTEREST, AX
    MOV INT_REM, DX       ; 保存余数

    POP DX
    POP BX
    POP AX
    RET
M2_CALC_SIMPLE_INTEREST_PROC ENDP


; ---------------------------------------------------------
; [MEMBER 2 WORK] - 功能 2: 到期总额计算
; ---------------------------------------------------------
M2_CALC_TOTAL_MATURITY_PROC PROC
    PUSH AX
    PUSH BX

    MOV AX, PRINCIPAL
    ADD AX, SIMPLE_INTEREST
    MOV TOTAL_MATURITY, AX

    POP BX
    POP AX
    RET
M2_CALC_TOTAL_MATURITY_PROC ENDP


; =========================================================
; [MEMBER 3 WORK] - ADVANCED CALCULATIONS & REPORT DISPLAY
; =========================================================

M3_CALC_ADVANCED_PROC PROC
    PUSH AX
    PUSH BX
    PUSH DX

    ; [功能 3]: 扣税 Tax = Simple Interest * 10 / 100
    MOV AX, SIMPLE_INTEREST
    MOV BX, 10D
    MUL BX
    MOV BX, 100D
    DIV BX
    MOV TAX_DEDUCTION, AX

    ; [功能 4]: 每月预估收益 Monthly Payout = (Simple Interest - Tax) / Months
    MOV AX, SIMPLE_INTEREST
    SUB AX, TAX_DEDUCTION
    MOV DX, 0
    MOV BX, TENURE_MONTHS
    CMP BX, 0
    JE SKIP_DIV
    DIV BX
    MOV MONTHLY_PAYOUT, AX
    JMP M3_CALC_DONE

SKIP_DIV:
    MOV MONTHLY_PAYOUT, 0

M3_CALC_DONE:
    POP DX
    POP BX
    POP AX
    RET
M3_CALC_ADVANCED_PROC ENDP


; ---------------------------------------------------------
; [MEMBER 3 WORK] - 报告打印 (使用老师教的格式化小数点)
; ---------------------------------------------------------
M3_DISPLAY_SUMMARY_PROC PROC
    PUSH AX
    PUSH DX

    MOV AH, 09H
    LEA DX, TITLE_BM
    INT 21H

    ; 1. 本金显示 (直接补 .00)
    MOV AH, 09H
    LEA DX, RPT_P
    INT 21H
    MOV AX, PRINCIPAL
    CALL M3_PRINT_NUMBER
    CALL PRINT_DOT_ZERO0    ; 打印 .00

    ; 2. 利率
    MOV AH, 09H
    LEA DX, RPT_R
    INT 21H
    MOV AX, RATE
    CALL M3_PRINT_NUMBER

    ; 3. 期限
    MOV AH, 09H
    LEA DX, RPT_M
    INT 21H
    MOV AX, TENURE_MONTHS
    CALL M3_PRINT_NUMBER

    ; 4. 利息 (打印整数 + 用余数算出来的两位小数)
    MOV AH, 09H
    LEA DX, RPT_F1
    INT 21H
    MOV AX, SIMPLE_INTEREST
    CALL M3_PRINT_NUMBER
    
    ; 老师教的余数算小数法: (余数 * 100) / 1200
    MOV AX, INT_REM
    MOV BX, 100D
    MUL BX
    MOV BX, 1200D
    DIV BX                  ; AX 即为两位小数位
    CALL PRINT_DECIMAL_PART

    ; 5. 到期总额 (显示整数 + 相同的两位小数)
    MOV AH, 09H
    LEA DX, RPT_F2
    INT 21H
    MOV AX, TOTAL_MATURITY
    CALL M3_PRINT_NUMBER
    
    MOV AX, INT_REM
    MOV BX, 100D
    MUL BX
    MOV BX, 1200D
    DIV BX
    CALL PRINT_DECIMAL_PART

    ; 6. 扣税 (直接补 .00)
    MOV AH, 09H
    LEA DX, RPT_F3
    INT 21H
    MOV AX, TAX_DEDUCTION
    CALL M3_PRINT_NUMBER
    CALL PRINT_DOT_ZERO0

    ; 7. 每月收益 (直接补 .00)
    MOV AH, 09H
    LEA DX, RPT_F4
    INT 21H
    MOV AX, MONTHLY_PAYOUT
    CALL M3_PRINT_NUMBER
    CALL PRINT_DOT_ZERO0

    MOV AH, 09H
    LEA DX, NL
    INT 21H

    POP DX
    POP AX
    RET
M3_DISPLAY_SUMMARY_PROC ENDP


; =========================================================
; 小数点辅助打印工具 (全部使用 Chapter 4 单字符输出 INT 21H / AH=02H)
; =========================================================

; 直接打印 ".00"
PRINT_DOT_ZERO0 PROC
    PUSH AX
    PUSH DX
    MOV AH, 02H
    MOV DL, '.'
    INT 21H
    MOV DL, '0'
    INT 21H
    MOV DL, '0'
    INT 21H
    POP DX
    POP AX
    RET
PRINT_DOT_ZERO0 ENDP

; 打印小数点和 AX 中的两位数字 (例如 AX=76 -> 打印 .76)
PRINT_DECIMAL_PART PROC
    PUSH AX
    PUSH BX
    PUSH DX

    PUSH AX               ; 保存小数值
    MOV AH, 02H
    MOV DL, '.'
    INT 21H               ; 打印 '.'

    POP AX
    MOV BX, 10D
    MOV DX, 0
    DIV BX                ; AL = 十位, DL = 个位

    PUSH DX
    MOV DL, AL
    ADD DL, '0'
    MOV AH, 02H
    INT 21H               ; 打印十位数

    POP DX
    ADD DL, '0'
    MOV AH, 02H
    INT 21H               ; 打印个位数

    POP DX
    POP BX
    POP AX
    RET
PRINT_DECIMAL_PART ENDP


; ---------------------------------------------------------
; 多位数字通用打印工具 (整数部分)
; ---------------------------------------------------------
M3_PRINT_NUMBER PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI

    CMP AX, 0
    JNE CONVERT_NUM
    MOV DL, '0'
    MOV AH, 02H
    INT 21H
    JMP PRINT_DONE

CONVERT_NUM:
    MOV BX, 10D
    MOV SI, 0

CONVERT_LOOP:
    MOV DX, 0
    DIV BX
    MOV DIGITS[SI], DL
    INC SI
    CMP AX, 0
    JNE CONVERT_LOOP

PRINT_LOOP:
    DEC SI
    MOV DL, DIGITS[SI]
    ADD DL, '0'
    MOV AH, 02H
    INT 21H
    CMP SI, 0
    JNE PRINT_LOOP

PRINT_DONE:
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
M3_PRINT_NUMBER ENDP

END MAIN
