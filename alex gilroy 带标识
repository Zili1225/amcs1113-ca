.MODEL SMALL
.STACK 100H

.DATA

; =========================================================
; [MEMBER 2 WORK] - DATA DECLARATIONS (数据声明)
; =========================================================
    MAX_PRINCIPAL   EQU 9999D     ; 本金上限 RM 9999
    MAX_RATE        EQU 99D       ; 利率上限 99%
    MAX_TENURE      EQU 99D       ; 期限上限 99个月

    PRINCIPAL       DW 0          ; 本金 (RM)
    RATE            DW 0          ; 年利率 (%)
    TENURE_MONTHS   DW 0          ; 存款期限 (月)
    SIMPLE_INTEREST DW 0          ; [功能1] 单利利息 (RM)
    TOTAL_MATURITY  DW 0          ; [功能2] 到期总额 (RM)

    ; Member 2 输入提示与错误信息
    STR_P       DB 0DH, 0AH, "ENTER PRINCIPAL AMOUNT (RM 1-9999): $"
    STR_R       DB 0DH, 0AH, "ENTER ANNUAL RATE % (1-99): $"
    STR_M       DB 0DH, 0AH, "ENTER TENURE IN MONTHS (1-99): $"
    STR_ERR     DB 0DH, 0AH, "INVALID INPUT OR OUT OF RANGE! PLEASE TRY AGAIN.$"


; =========================================================
; [MEMBER 3 WORK] - DATA DECLARATIONS
; =========================================================
    TAX_DEDUCTION   DW 0          ; [功能3] 扣税 10%
    NET_INTEREST    DW 0          ; 税后净利息
    MONTHLY_PAYOUT  DW 0          ; [功能4] 每月预估收益

    TITLE_BM    DB 0DH, 0AH, "========================================"
                DB 0DH, 0AH, "      BANK ACCOUNT SUMMARY REPORT       "
                DB 0DH, 0AH, "========================================$"
    RPT_P       DB 0DH, 0AH, "  PRINCIPAL AMOUNT : RM $"
    RPT_R       DB 0DH, 0AH, "  ANNUAL RATE (%)  : $"
    RPT_M       DB 0DH, 0AH, "  TENURE (MONTHS)  : $"
    RPT_F1      DB 0DH, 0AH, "  TOTAL INTEREST   : RM $"
    RPT_F2      DB 0DH, 0AH, "  TOTAL AT MATURITY: RM $"
    RPT_F3      DB 0DH, 0AH, "  TAX DEDUCTION(10%): RM $"
    RPT_F4      DB 0DH, 0AH, "  MONTHLY PAYOUT   : RM $"
    NL          DB 0DH, 0AH, "$"

    DIGITS      DB 6 DUP(?)       ; 数字打印缓冲区

.CODE

; =========================================================
; MAIN PROC (主程序流程控制)
; =========================================================
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    ; 1. 调用 Member 2 的数据输入模块 (带 Validation 校验)
    CALL M2_INPUT_DATA_PROC

    ; 2. 调用 Member 2 的前两个基础计算功能
    CALL M2_CALC_SIMPLE_INTEREST_PROC
    CALL M2_CALC_TOTAL_MATURITY_PROC

    ; 3. 调用 Member 3 的高级计算功能 (扣税与月收益)
    CALL M3_CALC_ADVANCED_PROC

    ; 4. 调用 Member 3 的账单报告显示
    CALL M3_DISPLAY_SUMMARY_PROC

    ; 程序退出
    MOV AX, 4C00H
    INT 21H
MAIN ENDP


; =========================================================
; =========================================================
; [MEMBER 2 WORK] - MODULE 1: DATA ENTRY WITH VALIDATION
; 数据输入模块 (带完整错误校验与范围拦截)
; =========================================================
; =========================================================

M2_INPUT_DATA_PROC PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

GET_P:
    MOV AH, 09H
    LEA DX, STR_P
    INT 21H
    
    MOV CX, 1              ; 最小值 = 1
    MOV DX, MAX_PRINCIPAL  ; 最大值 = 9999
    CALL M2_READ_NUM_RANGE
    JC ERR_P               ; 如果 CF=1 代表输入错误，重试
    MOV PRINCIPAL, AX
    JMP GET_R

ERR_P:
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    JMP GET_P

GET_R:
    MOV AH, 09H
    LEA DX, STR_R
    INT 21H
    
    MOV CX, 1              ; 最小值 = 1
    MOV DX, MAX_RATE       ; 最大值 = 99
    CALL M2_READ_NUM_RANGE
    JC ERR_R
    MOV RATE, AX
    JMP GET_M

ERR_R:
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    JMP GET_R

GET_M:
    MOV AH, 09H
    LEA DX, STR_M
    INT 21H
    
    MOV CX, 1              ; 最小值 = 1
    MOV DX, MAX_TENURE     ; 最大值 = 99
    CALL M2_READ_NUM_RANGE
    JC ERR_M
    MOV TENURE_MONTHS, AX
    JMP INPUT_DONE

ERR_M:
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    JMP GET_M

INPUT_DONE:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
M2_INPUT_DATA_PROC ENDP


; ---------------------------------------------------------
; [MEMBER 2 WORK] - READ_NUM_RANGE
; 键盘读取与范围检测通用工具 (简单且严谨的学生写法)
; 入口: CX = MIN, DX = MAX
; 出口: AX = 转换为整数的数值 | CF=0 (成功), CF=1 (失败)
; ---------------------------------------------------------
M2_READ_NUM_RANGE PROC
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI

    MOV SI, CX            ; SI 保存最小值
    MOV DI, DX            ; DI 保存最大值
    MOV BX, 0             ; BX 作为数值累加器
    MOV CX, 0             ; CX 记录输入字符个数

READ_CHAR_LOOP:
    MOV AH, 01H           ; 单字符带回显读取 (Chapter 4)
    INT 21H

    CMP AL, 0DH           ; 检查 Enter 键 (0DH)
    JE CHECK_RANGE

    CMP AL, '0'           ; 小于 '0' 则非法
    JB INPUT_ERROR
    CMP AL, '9'           ; 大于 '9' 则非法
    JA INPUT_ERROR

    SUB AL, '0'           ; ASCII 转数值
    MOV AH, 0
    PUSH AX               ; 压栈保存新输入的数字

    ; BX = BX * 10
    MOV AX, BX
    MOV DX, 10D
    MUL DX
    JC POP_AND_ERR        ; 溢出检查

    POP DX
    ADD AX, DX            ; AX = (BX * 10) + 新数字
    JC INPUT_ERROR        ; 进位溢出检查

    MOV BX, AX            ; 更新累加数值
    INC CX                ; 字符数计数 + 1
    JMP READ_CHAR_LOOP

POP_AND_ERR:
    POP AX                ; 恢复堆栈平衡

INPUT_ERROR:
    STC                   ; 设置 CF = 1 表示输入错误
    JMP RANGE_EXIT

CHECK_RANGE:
    CMP CX, 0             ; 如果未输入任何字符直接 Enter，报错
    JE INPUT_ERROR

    CMP BX, SI            ; 是否小于最小值
    JB INPUT_ERROR
    CMP BX, DI            ; 是否大于最大值
    JA INPUT_ERROR

    MOV AX, BX            ; 成功，结果存入 AX
    CLC                   ; 设置 CF = 0 表示成功

RANGE_EXIT:
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
M2_READ_NUM_RANGE ENDP


; =========================================================
; =========================================================
; [MEMBER 2 WORK] - MODULE 4: CALCULATION FUNCTIONS 1 & 2
; 计算功能 1 (单利) 与 功能 2 (到期总额)
; =========================================================
; =========================================================

; ---------------------------------------------------------
; [MEMBER 2 WORK] - 功能 1: 单利计算
; 公式: Interest = Principal * Rate * Months / 1200
; ---------------------------------------------------------
M2_CALC_SIMPLE_INTEREST_PROC PROC
    PUSH AX
    PUSH BX
    PUSH DX

    MOV AX, PRINCIPAL
    MOV BX, RATE
    MUL BX                ; DX:AX = P * R

    MOV BX, TENURE_MONTHS
    MUL BX                ; DX:AX = (P * R) * M

    MOV BX, 1200D
    DIV BX                ; AX = (P * R * M) / 1200

    MOV SIMPLE_INTEREST, AX

    POP DX
    POP BX
    POP AX
    RET
M2_CALC_SIMPLE_INTEREST_PROC ENDP


; ---------------------------------------------------------
; [MEMBER 2 WORK] - 功能 2: 到期总额计算
; 公式: Total = Principal + Simple Interest
; ---------------------------------------------------------
M2_CALC_TOTAL_MATURITY_PROC PROC
    PUSH AX
    PUSH BX

    MOV AX, PRINCIPAL
    ADD AX, SIMPLE_INTEREST
    MOV TOTAL_MATURITY, AX

    POP BX
    POP AX
    RET
M2_CALC_TOTAL_MATURITY_PROC ENDP


; =========================================================
; =========================================================
; [MEMBER 3 WORK] - ADVANCED CALCULATIONS & REPORT DISPLAY
; (Member 3 的扣税/月收益计算与报告显示模块)
; =========================================================
; =========================================================

M3_CALC_ADVANCED_PROC PROC
    PUSH AX
    PUSH BX
    PUSH DX

    ; [功能 3]: 扣税 Tax = Simple Interest * 10 / 100
    MOV AX, SIMPLE_INTEREST
    MOV BX, 10D
    MUL BX
    MOV BX, 100D
    DIV BX
    MOV TAX_DEDUCTION, AX

    ; 税后净利息 Net Interest = Simple Interest - Tax
    MOV AX, SIMPLE_INTEREST
    SUB AX, TAX_DEDUCTION
    MOV NET_INTEREST, AX

    ; [功能 4]: 每月预估收益 Monthly Payout = Net Interest / Months
    MOV AX, NET_INTEREST
    MOV DX, 0
    MOV BX, TENURE_MONTHS
    CMP BX, 0
    JE SKIP_DIV
    DIV BX
    MOV MONTHLY_PAYOUT, AX
    JMP M3_CALC_DONE

SKIP_DIV:
    MOV MONTHLY_PAYOUT, 0

M3_CALC_DONE:
    POP DX
    POP BX
    POP AX
    RET
M3_CALC_ADVANCED_PROC ENDP


M3_DISPLAY_SUMMARY_PROC PROC
    PUSH AX
    PUSH DX

    MOV AH, 09H
    LEA DX, TITLE_BM
    INT 21H

    MOV AH, 09H
    LEA DX, RPT_P
    INT 21H
    MOV AX, PRINCIPAL
    CALL M3_PRINT_NUMBER

    MOV AH, 09H
    LEA DX, RPT_R
    INT 21H
    MOV AX, RATE
    CALL M3_PRINT_NUMBER

    MOV AH, 09H
    LEA DX, RPT_M
    INT 21H
    MOV AX, TENURE_MONTHS
    CALL M3_PRINT_NUMBER

    MOV AH, 09H
    LEA DX, RPT_F1
    INT 21H
    MOV AX, SIMPLE_INTEREST
    CALL M3_PRINT_NUMBER

    MOV AH, 09H
    LEA DX, RPT_F2
    INT 21H
    MOV AX, TOTAL_MATURITY
    CALL M3_PRINT_NUMBER

    MOV AH, 09H
    LEA DX, RPT_F3
    INT 21H
    MOV AX, TAX_DEDUCTION
    CALL M3_PRINT_NUMBER

    MOV AH, 09H
    LEA DX, RPT_F4
    INT 21H
    MOV AX, MONTHLY_PAYOUT
    CALL M3_PRINT_NUMBER

    MOV AH, 09H
    LEA DX, NL
    INT 21H

    POP DX
    POP AX
    RET
M3_DISPLAY_SUMMARY_PROC ENDP


; ---------------------------------------------------------
; [MEMBER 3 WORK] - 多位数字通用打印工具
; ---------------------------------------------------------
M3_PRINT_NUMBER PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI

    CMP AX, 0
    JNE CONVERT_NUM
    MOV DL, '0'
    MOV AH, 02H
    INT 21H
    JMP PRINT_DONE

CONVERT_NUM:
    MOV BX, 10D
    MOV SI, 0

CONVERT_LOOP:
    MOV DX, 0
    DIV BX
    MOV DIGITS[SI], DL
    INC SI
    CMP AX, 0
    JNE CONVERT_LOOP

PRINT_LOOP:
    DEC SI
    MOV DL, DIGITS[SI]
    ADD DL, '0'
    MOV AH, 02H
    INT 21H
    CMP SI, 0
    JNE PRINT_LOOP

PRINT_DONE:
    POP SI
    POP DX
    POP CX
    POP BX
    POP AX
    RET
M3_PRINT_NUMBER ENDP

END MAIN
