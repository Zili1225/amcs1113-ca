.MODEL SMALL
.STACK 100H

.DATA
username DB 'admin'
password DB '1234'

userInput DB 5 DUP(?)
passInput DB 4 DUP(?)

studentID DB 11 DUP('$')

msgUser DB 13,10,'Username : $'
msgPass DB 13,10,'Password : $'
msgLoginOK DB 13,10,'Login Successful!$'
msgLoginFail DB 13,10,'Login Failed!$'

msgID DB 13,10,'Enter Student ID (max 10 chars): $'
msgIDOut DB 13,10,'Student ID : $'

msgCW DB 13,10,'Enter Coursework Mark (00-99): $'
msgExam DB 13,10,'Enter Exam Mark (00-99): $'
msgInvalid DB 13,10,'Invalid Input! Please enter digits only.$'

msgReport DB 13,10,13,10,'===== STUDENT RESULT REPORT =====$'
msgCWOut DB 13,10,'Coursework : $'
msgExamOut DB 13,10,'Exam       : $'
msgTotal DB 13,10,'Total      : $'
msgAvg DB 13,10,'Average    : $'
msgGrade DB 13,10,'Grade      : $'

coursework DB ?
exam DB ?
total DB ?
average DB ?

.CODE

MAIN PROC
    MOV AX,@DATA
    MOV DS,AX

; ===== LOGIN =====
    LEA DX,msgUser
    MOV AH,09H
    INT 21H
    CALL READ_USERNAME

    LEA SI,userInput
    LEA DI,username
    MOV CX,5

CHECK_USER:
    MOV AL,[SI]
    CMP AL,[DI]
    JNE LOGIN_FAIL
    INC SI
    INC DI
    LOOP CHECK_USER

    LEA DX,msgPass
    MOV AH,09H
    INT 21H
    CALL READ_PASSWORD

    LEA SI,passInput
    LEA DI,password
    MOV CX,4

CHECK_PASS:
    MOV AL,[SI]
    CMP AL,[DI]
    JNE LOGIN_FAIL
    INC SI
    INC DI
    LOOP CHECK_PASS

    LEA DX,msgLoginOK
    MOV AH,09H
    INT 21H

; ===== INPUT STUDENT ID =====
    LEA DX,msgID
    MOV AH,09H
    INT 21H

    CALL READ_STUDENT_ID

    JMP MARK_SYSTEM

LOGIN_FAIL:
    LEA DX,msgLoginFail
    MOV AH,09H
    INT 21H
    MOV AH,4CH
    INT 21H

; ===== INPUT MARKS =====
MARK_SYSTEM:
    LEA DX,msgCW
    MOV AH,09H
    INT 21H
    CALL READ_NUM_VALIDATE
    MOV coursework,AL

    LEA DX,msgExam
    MOV AH,09H
    INT 21H
    CALL READ_NUM_VALIDATE
    MOV exam,AL

; ===== CALCULATE TOTAL =====
    MOV AL,coursework
    ADD AL,exam
    MOV total,AL

; ===== CALCULATE AVERAGE =====
    MOV AH,0
    MOV BL,2
    DIV BL
    MOV average,AL

; ===== DISPLAY REPORT =====
    LEA DX,msgReport
    MOV AH,09H
    INT 21H

    LEA DX,msgIDOut
    MOV AH,09H
    INT 21H

    LEA DX,studentID
    MOV AH,09H
    INT 21H

    LEA DX,msgCWOut
    MOV AH,09H
    INT 21H
    MOV AL,coursework
    CALL PRINT_NUM

    LEA DX,msgExamOut
    MOV AH,09H
    INT 21H
    MOV AL,exam
    CALL PRINT_NUM

    LEA DX,msgTotal
    MOV AH,09H
    INT 21H
    MOV AL,total
    CALL PRINT_NUM

    LEA DX,msgAvg
    MOV AH,09H
    INT 21H
    MOV AL,average
    CALL PRINT_NUM

    LEA DX,msgGrade
    MOV AH,09H
    INT 21H

; Grade based on average
    MOV AL,average

    CMP AL,80
    JAE GRADE_A

    CMP AL,70
    JAE GRADE_B

    CMP AL,60
    JAE GRADE_C

    CMP AL,50
    JAE GRADE_D

    MOV DL,'F'
    JMP DISPLAY_GRADE

GRADE_A:
    MOV DL,'A'
    JMP DISPLAY_GRADE

GRADE_B:
    MOV DL,'B'
    JMP DISPLAY_GRADE

GRADE_C:
    MOV DL,'C'
    JMP DISPLAY_GRADE

GRADE_D:
    MOV DL,'D'

DISPLAY_GRADE:
    MOV AH,02H
    INT 21H

    MOV AH,4CH
    INT 21H

MAIN ENDP

; ===== READ USERNAME =====
READ_USERNAME PROC
    LEA SI,userInput
    MOV CX,5

READ_U:
    MOV AH,01H
    INT 21H
    MOV [SI],AL
    INC SI
    LOOP READ_U
    RET
READ_USERNAME ENDP

; ===== READ PASSWORD =====
READ_PASSWORD PROC
    LEA SI,passInput
    MOV CX,4

READ_P:
    MOV AH,01H
    INT 21H
    MOV [SI],AL
    INC SI
    LOOP READ_P
    RET
READ_PASSWORD ENDP

; ===== READ STUDENT ID =====
READ_STUDENT_ID PROC
    LEA SI,studentID
    MOV CX,10

READ_ID:
    MOV AH,01H
    INT 21H

    CMP AL,13
    JE FINISH_ID

    MOV [SI],AL
    INC SI
    LOOP READ_ID

FINISH_ID:
    MOV BYTE PTR [SI],'$'
    RET
READ_STUDENT_ID ENDP

; ===== READ 2 DIGITS WITH VALIDATION =====
READ_NUM_VALIDATE PROC

GET_INPUT:
    MOV AH,01H
    INT 21H

    CMP AL,'0'
    JB INVALID
    CMP AL,'9'
    JA INVALID

    SUB AL,'0'
    MOV BL,10
    MUL BL
    MOV BH,AL

    MOV AH,01H
    INT 21H

    CMP AL,'0'
    JB INVALID
    CMP AL,'9'
    JA INVALID

    SUB AL,'0'
    ADD AL,BH
    RET

INVALID:
    LEA DX,msgInvalid
    MOV AH,09H
    INT 21H
    JMP GET_INPUT

READ_NUM_VALIDATE ENDP

; ===== PRINT NUMBER 0-255 =====
PRINT_NUM PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

    MOV AH,0
    MOV BX,10
    MOV CX,0

    CMP AX,0
    JNE CONVERT

    MOV DL,'0'
    MOV AH,02H
    INT 21H
    JMP DONE_PRINT

CONVERT:
DIV_LOOP:
    MOV DX,0
    DIV BX
    PUSH DX
    INC CX
    CMP AX,0
    JNE DIV_LOOP

PRINT_LOOP:
    POP DX
    ADD DL,'0'
    MOV AH,02H
    INT 21H
    LOOP PRINT_LOOP

DONE_PRINT:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
PRINT_NUM ENDP

END MAIN
