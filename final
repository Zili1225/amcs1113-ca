.MODEL SMALL
.STACK 100

.DATA

; =========================================================
; ACCOUNT STORAGE
; Maximum 3 accounts
; Each User ID  = 4 characters
; Each Password = 4 characters
; Pre-seeded with 1 default account: A001 / 1234
; =========================================================

accountIDs       DB 'A','0','0','1', 8 DUP(?)
accountPasswords DB '1','2','3','4', 8 DUP(?)

accountCount     DB 1
currentAccount   DB 0

USERID           DB 4 DUP(?)
PASSWORD         DB 4 DUP(?)

; =========================================================
; BANK VARIABLES
; =========================================================

principal        DW 0
rate             DW 5
months           DW 0

totalInterest    DW 0
taxDeduction     DW 0
netInterest      DW 0
monthlyPayout    DW 0

DIGITS           DB 6 DUP(?)

LOGINIDBUF       DB 4 DUP(?)
LOGINPASSBUF     DB 4 DUP(?)

; =========================================================
; CREATE ACCOUNT
; =========================================================

CREATE_TITLE     DB 13,10
                 DB "========================================",13,10
                 DB "          CREATE ACCOUNT",13,10
                 DB "========================================",13,10,"$"

CREATE_ID        DB "Enter User ID (4 characters): $"

CREATE_PASS      DB 13,10
                 DB "Enter Password (4 characters): $"

ACCOUNT_SUCCESS  DB 13,10
                 DB "ACCOUNT CREATED SUCCESSFULLY!",13,10,"$"

ACCOUNT_FULL     DB 13,10
                 DB "ERROR: Maximum 3 accounts reached!",13,10,"$"

; =========================================================
; LOGIN
; =========================================================

LOGIN_TITLE      DB 13,10
                 DB "========================================",13,10
                 DB "                 LOGIN",13,10
                 DB "========================================",13,10
                 DB "1. Login",13,10
                 DB "2. Register Account",13,10
                 DB "3. End System",13,10
                 DB "========================================",13,10
                 DB "Enter your option: $"

LOGIN_ID         DB 13,10
                 DB "Enter User ID: $"

LOGIN_PASS       DB 13,10
                 DB "Enter Password: $"

LOGIN_ERROR      DB 13,10
                 DB "ERROR: Invalid User ID or Password!",13,10
                 DB "Please try again.",13,10,"$"

LOGIN_SUCCESS    DB 13,10
                 DB "LOGIN SUCCESSFUL!",13,10
                 DB "Welcome to the Bank Account System.",13,10,"$"

INVALIDLOGINOPTION DB 13,10
                   DB "ERROR: Invalid option!",13,10,"$"

; =========================================================
; MAIN MENU
; =========================================================

MENUMSG          DB 13,10
                 DB "========================================",13,10
                 DB "              MAIN MENU",13,10
                 DB "========================================",13,10
                 DB "1. Calculate Total Interest",13,10
                 DB "2. Calculate Net Interest",13,10
                 DB "3. Monthly Payout",13,10
                 DB "4. Bank Account Summary",13,10
                 DB "5. Exit",13,10
                 DB "========================================",13,10
                 DB "Enter your option: $"

INVALIDOPTION    DB 13,10
                 DB "ERROR: Invalid option!",13,10,"$"

; =========================================================
; INPUT
; =========================================================

INPUTPRINCIPAL   DB 13,10
                 DB "Enter Principal Amount (RM): $"

INPUTMONTHS      DB 13,10
                 DB "Enter Number of Months: $"

INVALIDINPUT     DB 13,10
                 DB "ERROR: Invalid input!",13,10
                 DB "Please enter numbers only and no negative value.",13,10,"$"

ZEROMONTH        DB 13,10
                 DB "ERROR: Number of months cannot be 0!",13,10,"$"

; =========================================================
; RESULTS
; =========================================================

TOTALMSG         DB 13,10
                 DB "Total Interest : RM $"

TAXMSG           DB 13,10
                 DB "Tax Deduction (10%) : RM $"

NETMSG           DB 13,10
                 DB "Net Interest : RM $"

MONTHLYMSG       DB 13,10
                 DB "Monthly Payout : RM $"

; =========================================================
; BANK ACCOUNT SUMMARY
; =========================================================

TITLEBM          DB 13,10
                 DB "========================================",13,10
                 DB "       BANK ACCOUNT SUMMARY",13,10
                 DB "========================================$"

PRINCIPALM       DB 13,10
                 DB "Principal Amount : RM $"

SIMINTM          DB 13,10
                 DB "Total Interest   : RM $"

TAXM             DB 13,10
                 DB "Tax (10%)        : RM $"

NETM             DB 13,10
                 DB "Net Interest     : RM $"

MONTHM           DB 13,10
                 DB "Monthly Payout   : RM $"

NL               DB 13,10,"$"


.CODE

; =========================================================
; MAIN
; =========================================================

MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

    ; Direct to Login Page (Default account A001 / 1234 is ready)
    CALL UserLogin


; =========================================================
; MAIN MENU LOOP
; =========================================================

MainMenuLoop:

    CALL MainMenu

    CMP AL, 1
    JE DoOption1

    CMP AL, 2
    JE DoOption2

    CMP AL, 3
    JE DoOption3

    CMP AL, 4
    JE DoOption4

    CMP AL, 5
    JE DoReturnLogin

    MOV AH, 09H
    LEA DX, INVALIDOPTION
    INT 21H

    JMP MainMenuLoop


; =========================================================
; OPTION 1
; =========================================================

DoOption1:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    MOV AH, 09H
    LEA DX, TOTALMSG
    INT 21H

    MOV AX, totalInterest
    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 2
; =========================================================

DoOption2:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    MOV AH, 09H
    LEA DX, TAXMSG
    INT 21H

    MOV AX, taxDeduction
    CALL PrintMoney

    MOV AH, 09H
    LEA DX, NETMSG
    INT 21H

    MOV AX, netInterest
    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 3
; =========================================================

DoOption3:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    MOV AH, 09H
    LEA DX, MONTHLYMSG
    INT 21H

    MOV AX, monthlyPayout
    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 4
; =========================================================

DoOption4:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest
    CALL BankAccountSummary

    JMP MainMenuLoop


; =========================================================
; OPTION 5
; RETURN TO LOGIN
; =========================================================

DoReturnLogin:

    CALL UserLogin

    JMP MainMenuLoop

MAIN ENDP


; =========================================================
; CREATE ACCOUNT
; =========================================================

CreateAccount PROC

    MOV AL, accountCount
    CMP AL, 3
    JB CreateAccountOK
    JMP AccountFull


CreateAccountOK:

    MOV AH, 09H
    LEA DX, CREATE_TITLE
    INT 21H


; =========================================================
; ENTER USER ID
; =========================================================

    MOV AH, 09H
    LEA DX, CREATE_ID
    INT 21H

    MOV SI, 0


CreateIDLoop:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JE CreateIDLoop

    MOV USERID[SI], AL

    INC SI

    CMP SI, 4
    JL CreateIDLoop


; =========================================================
; WAIT FOR ENTER
; =========================================================

CreateIDWaitEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE CreateIDWaitEnter


; =========================================================
; ENTER PASSWORD
; =========================================================

    MOV AH, 09H
    LEA DX, CREATE_PASS
    INT 21H

    MOV SI, 0


CreatePasswordLoop:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JE CreatePasswordLoop

    MOV PASSWORD[SI], AL

    INC SI

    CMP SI, 4
    JL CreatePasswordLoop


; =========================================================
; WAIT FOR ENTER
; =========================================================

CreatePasswordWaitEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE CreatePasswordWaitEnter


; =========================================================
; STORE USER ID
; =========================================================

    MOV AL, accountCount
    XOR AH, AH

    MOV BL, 4
    MUL BL

    MOV DI, AX

    MOV SI, 0


StoreIDLoop:

    MOV AL, USERID[SI]
    MOV accountIDs[DI], AL

    INC SI
    INC DI

    CMP SI, 4
    JL StoreIDLoop


; =========================================================
; STORE PASSWORD
; =========================================================

    MOV AL, accountCount
    XOR AH, AH

    MOV BL, 4
    MUL BL

    MOV DI, AX

    MOV SI, 0


StorePasswordLoop:

    MOV AL, PASSWORD[SI]
    MOV accountPasswords[DI], AL

    INC SI
    INC DI

    CMP SI, 4
    JL StorePasswordLoop


; =========================================================
; ACCOUNT CREATED
; =========================================================

    INC accountCount

    MOV AH, 09H
    LEA DX, ACCOUNT_SUCCESS
    INT 21H

    RET


; =========================================================
; ACCOUNT FULL
; =========================================================

AccountFull:

    MOV AH, 09H
    LEA DX, ACCOUNT_FULL
    INT 21H

    RET

CreateAccount ENDP


; =========================================================
; USER LOGIN
; =========================================================

UserLogin PROC


; =========================================================
; LOGIN PAGE
; =========================================================

LoginPage:

    MOV AH, 09H
    LEA DX, LOGIN_TITLE
    INT 21H


; =========================================================
; SELECT LOGIN / REGISTER / END SYSTEM
; =========================================================

   MOV AH, 01H
   INT 21H

   CMP AL, '1'
   JE StartLogin

   CMP AL, '2'
   JE CallRegister

   CMP AL, '3'
   JE CheckEndSystem

   MOV AH, 09H
   LEA DX, INVALIDLOGINOPTION
   INT 21H

   JMP LoginPage


CallRegister:
   ; Clear ENTER after option 2
   MOV AH, 01H
   INT 21H
   
   CALL CreateAccount
   JMP LoginPage


CheckEndSystem:
    JMP EndSystem


; =========================================================
; START LOGIN
; =========================================================

StartLogin:

; Clear ENTER after option 1

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JE LoginIDStart

    JMP StartLogin


; =========================================================
; USER ID
; =========================================================

LoginIDStart:

    MOV AH, 09H
    LEA DX, LOGIN_ID
    INT 21H

    MOV SI, 0


ReadLoginID:

    MOV AH, 01H
    INT 21H

    MOV LOGINIDBUF[SI], AL

    INC SI

    CMP SI, 4
    JL ReadLoginID


; =========================================================
; ENTER AFTER USER ID
; =========================================================

LoginIDEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE LoginIDEnter


; =========================================================
; COPY LOGIN ID
; =========================================================

    MOV SI, 0


CopyLoginID:

    MOV AL, LOGINIDBUF[SI]
    MOV USERID[SI], AL

    INC SI

    CMP SI, 4
    JL CopyLoginID


; =========================================================
; SEARCH ACCOUNT
; =========================================================

    MOV BL, 0


SearchAccount:

    MOV AL, BL
    CMP AL, accountCount

    JB SearchAccountOK
    JMP LoginError


SearchAccountOK:

    MOV AL, BL
    XOR AH, AH

    MOV DL, 4
    MUL DL

    MOV DI, AX
    MOV SI, 0


; =========================================================
; COMPARE USER ID
; =========================================================

CompareLoginID:

    MOV AL, USERID[SI]

    CMP AL, accountIDs[DI]

    JE LoginIDCharacterOK

    JMP NextAccount


LoginIDCharacterOK:

    INC SI
    INC DI

    CMP SI, 4
    JL CompareLoginID


; User ID found

    MOV currentAccount, BL

    JMP ReadLoginPassword


; =========================================================
; NEXT ACCOUNT
; =========================================================

NextAccount:

    INC BL

    JMP SearchAccount


; =========================================================
; PASSWORD
; =========================================================

ReadLoginPassword:

    MOV AH, 09H
    LEA DX, LOGIN_PASS
    INT 21H

    MOV SI, 0


ReadPasswordLoop:

    MOV AH, 01H
    INT 21H

    MOV LOGINPASSBUF[SI], AL

    INC SI

    CMP SI, 4
    JL ReadPasswordLoop


; =========================================================
; ENTER AFTER PASSWORD
; =========================================================

LoginPasswordEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE LoginPasswordEnter


; =========================================================
; COPY PASSWORD
; =========================================================

    MOV SI, 0


CopyLoginPassword:

    MOV AL, LOGINPASSBUF[SI]
    MOV PASSWORD[SI], AL

    INC SI

    CMP SI, 4
    JL CopyLoginPassword


; =========================================================
; CHECK PASSWORD
; =========================================================

    MOV AL, currentAccount
    XOR AH, AH

    MOV BL, 4
    MUL BL

    MOV DI, AX
    MOV SI, 0


ComparePasswordLoop:

    MOV AL, PASSWORD[SI]

    CMP AL, accountPasswords[DI]

    JE PasswordCharacterOK

    JMP LoginError


PasswordCharacterOK:

    INC SI
    INC DI

    CMP SI, 4
    JL ComparePasswordLoop


; =========================================================
; LOGIN SUCCESS
; =========================================================

    MOV AH, 09H
    LEA DX, LOGIN_SUCCESS
    INT 21H

    RET


; =========================================================
; LOGIN ERROR
; =========================================================

LoginError:

    MOV AH, 09H
    LEA DX, LOGIN_ERROR
    INT 21H

    JMP LoginPage


; =========================================================
; END SYSTEM
; =========================================================

EndSystem:

    MOV AH, 4CH
    INT 21H

UserLogin ENDP


; =========================================================
; MAIN MENU
; =========================================================

MainMenu PROC

    MOV AH, 09H
    LEA DX, MENUMSG
    INT 21H

    MOV AH, 01H
    INT 21H

    SUB AL, '0'

    MOV BL, AL


; =========================================================
; CLEAR ENTER
; =========================================================

MenuEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE MenuEnter

    MOV AL, BL

    RET

MainMenu ENDP


; =========================================================
; GET PRINCIPAL AND MONTHS
; =========================================================

GetPrincipalAndMonths PROC


GetPrincipalAgain:

    MOV AH, 09H
    LEA DX, INPUTPRINCIPAL
    INT 21H

    CALL ReadNumber

    JC PrincipalError

    MOV principal, AX

    JMP GetMonths


PrincipalError:

    MOV AH, 09H
    LEA DX, INVALIDINPUT
    INT 21H

    JMP GetPrincipalAgain


; =========================================================
; MONTHS
; =========================================================

GetMonths:

GetMonthsAgain:

    MOV AH, 09H
    LEA DX, INPUTMONTHS
    INT 21H

    CALL ReadNumber

    JC MonthsError

    CMP AX, 0
    JE MonthsZero

    MOV months, AX

    RET


MonthsError:

    MOV AH, 09H
    LEA DX, INVALIDINPUT
    INT 21H

    JMP GetMonthsAgain


MonthsZero:

    MOV AH, 09H
    LEA DX, ZEROMONTH
    INT 21H

    JMP GetMonthsAgain

GetPrincipalAndMonths ENDP


; =========================================================
; READ NUMBER
; =========================================================

ReadNumber PROC

    XOR BX, BX
    MOV SI, 0


ReadNumberLoop:

    MOV AH, 01H
    INT 21H


    ; ENTER

    CMP AL, 0DH
    JE ReadNumberDone


    ; Negative sign

    CMP AL, '-'

    ; Local jump to invalid
    JE NumberNegative

    JMP CheckNumberDigit


NumberNegative:

    JMP ReadNumberInvalid


; =========================================================
; CHECK DIGIT
; =========================================================

CheckNumberDigit:

    CMP AL, '0'
    JB ReadNumberInvalid

    CMP AL, '9'
    JA ReadNumberInvalid


    ; Convert ASCII to number

    SUB AL, '0'

    XOR AH, AH

    MOV SI, AX


    ; BX * 10

    MOV AX, BX

    MOV DX, 10

    MUL DX


    ; Add digit

    ADD AX, SI

    JC ReadNumberInvalid

    MOV BX, AX

    JMP ReadNumberLoop


; =========================================================
; INVALID INPUT
; =========================================================

ReadNumberInvalid:

ClearInvalidInput:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE ClearInvalidInput

    STC

    RET


; =========================================================
; NUMBER COMPLETE
; =========================================================

ReadNumberDone:

    MOV AX, BX

    CLC

    RET

ReadNumber ENDP


; =========================================================
; CALCULATE INTEREST
; =========================================================

CalculateInterest PROC

    ; Total Interest
    ; principal * rate

    MOV AX, principal
    MOV BX, rate

    MUL BX

    MOV totalInterest, AX


    ; Tax = Total Interest / 10

    MOV AX, totalInterest
    MOV BX, 10

    XOR DX, DX

    DIV BX

    MOV taxDeduction, AX


    ; Net Interest
    ; Total Interest - Tax

    MOV AX, totalInterest

    SUB AX, taxDeduction

    MOV netInterest, AX


    ; Monthly Payout
    ; Net Interest / Months

    MOV AX, netInterest

    XOR DX, DX

    MOV BX, months

    DIV BX

    MOV monthlyPayout, AX

    RET

CalculateInterest ENDP


; =========================================================
; BANK ACCOUNT SUMMARY
; =========================================================

BankAccountSummary PROC

    MOV AH, 09H
    LEA DX, TITLEBM
    INT 21H


; =========================================================
; PRINCIPAL
; Principal is direct RM
; =========================================================

    MOV AH, 09H
    LEA DX, PRINCIPALM
    INT 21H

    MOV AX, principal

    CALL PrintNumber

    MOV DL, '.'
    MOV AH, 02H
    INT 21H

    MOV DL, '0'
    MOV AH, 02H
    INT 21H

    MOV DL, '0'
    MOV AH, 02H
    INT 21H


; =========================================================
; TOTAL INTEREST
; =========================================================

    MOV AH, 09H
    LEA DX, SIMINTM
    INT 21H

    MOV AX, totalInterest

    CALL PrintMoney


; =========================================================
; TAX
; =========================================================

    MOV AH, 09H
    LEA DX, TAXM
    INT 21H

    MOV AX, taxDeduction

    CALL PrintMoney


; =========================================================
; NET INTEREST
; =========================================================

    MOV AH, 09H
    LEA DX, NETM
    INT 21H

    MOV AX, netInterest

    CALL PrintMoney


; =========================================================
; MONTHLY PAYOUT
; =========================================================

    MOV AH, 09H
    LEA DX, MONTHM
    INT 21H

    MOV AX, monthlyPayout

    CALL PrintMoney


    MOV AH, 09H
    LEA DX, NL
    INT 21H

    RET

BankAccountSummary ENDP


; =========================================================
; PRINT MONEY
; =========================================================

PrintMoney PROC

    XOR DX, DX

    MOV BX, 100

    DIV BX

    MOV DI, DX

    CALL PrintNumber


    MOV DL, '.'
    MOV AH, 02H
    INT 21H


    MOV AX, DI

    CALL PrintTwoDigits

    RET

PrintMoney ENDP


; =========================================================
; PRINT NUMBER
; =========================================================

PrintNumber PROC

    CMP AX, 0
    JNE ConvertNumber

    MOV DL, '0'
    MOV AH, 02H
    INT 21H

    RET


ConvertNumber:

    MOV BX, 10

    MOV SI, 0


ConvertLoop:

    XOR DX, DX

    DIV BX

    MOV DIGITS[SI], DL

    INC SI

    CMP AX, 0
    JNE ConvertLoop


PrintLoop:

    DEC SI

    MOV DL, DIGITS[SI]

    ADD DL, '0'

    MOV AH, 02H
    INT 21H

    CMP SI, 0
    JNE PrintLoop

    RET

PrintNumber ENDP


; =========================================================
; PRINT TWO DIGITS
; =========================================================

PrintTwoDigits PROC

    XOR DX, DX

    MOV BX, 10

    DIV BX

    MOV SI, DX


    ADD AL, '0'

    MOV DL, AL

    MOV AH, 02H
    INT 21H


    MOV DX, SI

    ADD DL, '0'

    MOV AH, 02H
    INT 21H

    RET

PrintTwoDigits ENDP


END MAIN
