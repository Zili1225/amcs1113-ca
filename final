.MODEL SMALL
.STACK 100H

.DATA

; =========================================================
; [MEMBER 1 WORK] - ACCOUNT DATA & SYSTEM MESSAGES
; =========================================================
accountID1      DB "A001",'$'
accountID2      DB "A002",'$'
accountID3      DB "A003",'$'

USERID          DB 4 DUP(?)
accountCount    DB 3
currentAccount  DB 0

LOGINMSG        DB 13,10
                DB "========================================",13,10
                DB "          BANK ACCOUNT SYSTEM",13,10
                DB "========================================",13,10
                DB "Enter User ID: $"

INVALIDID       DB 13,10
                DB "ERROR: Invalid User ID!",13,10
                DB "Please enter A001, A002 or A003.",13,10,"$"

MENUMSG         DB 13,10
                DB 13,10
                DB "========================================",13,10
                DB "              MAIN MENU",13,10
                DB "========================================",13,10
                DB "1. Calculate Total Interest",13,10
                DB "2. Calculate Net Interest",13,10
                DB "3. Monthly Payout",13,10
                DB "4. Bank Account Summary",13,10
                DB "5. Exit",13,10
                DB "========================================",13,10
                DB "Enter your option: $"

INVALIDOPTION   DB 13,10
                DB "ERROR: Invalid option!",13,10,"$"


; =========================================================
; [MEMBER 2 WORK] - DATA ENTRY & BASIC CALCULATION VARIABLES
; =========================================================
principal       DW 0              ; 本金 (RM)
rate            DW 5              ; 固定年利率 5%
months          DW 0              ; 存款期限 (月)
totalInterest   DW 0              ; [功能1] 单利总利息

INPUTPRINCIPAL  DB 13,10
                DB "Enter Principal Amount (RM): $"

INPUTMONTHS     DB 13,10
                DB "Enter Number of Months: $"

INVALIDINPUT    DB 13,10
                DB "ERROR: Invalid input!",13,10
                DB "Please enter numbers only and no negative value.",13,10,"$"

ZEROMONTH       DB 13,10
                DB "ERROR: Number of months cannot be 0!",13,10,"$"

TOTALMSG        DB 13,10
                DB "Total Interest : RM $"


; =========================================================
; [MEMBER 3 WORK] - ADVANCED CALCULATION & SUMMARY MESSAGES
; =========================================================
taxDeduction    DW 0              ; [功能3] 扣税 10%
netInterest     DW 0              ; 税后净利息
monthlyPayout   DW 0              ; [功能4] 每月平均派息

TAXMSG          DB 13,10
                DB "Tax Deduction (10%) : RM $"

NETMSG          DB 13,10
                DB "Net Interest : RM $"

MONTHLYMSG      DB 13,10
                DB "Monthly Payout : RM $"

TITLEBM         DB 13,10
                DB "========================================",13,10
                DB "        BANK ACCOUNT SUMMARY",13,10
                DB "========================================$"

PRINCIPALM      DB 13,10
                DB "Principal Amount : RM $"

SIMINTM         DB 13,10
                DB "Total Interest   : RM $"

TAXM            DB 13,10
                DB "Tax (10%)        : RM $"

NETM            DB 13,10
                DB "Net Interest     : RM $"

MONTHM          DB 13,10
                DB "Monthly Payout   : RM $"

NL              DB 13,10,"$"

DIGITS          DB 6 DUP(?)       ; 数字打印缓冲区


; =========================================================
; CODE SEGMENT
; =========================================================
.CODE

MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    ; 1. 调用 Member 1 登录
    CALL UserLogin

MainMenuLoop:
    ; 2. 调用 Member 1 菜单
    CALL MainMenu

    CMP AL, 1
    JE Option1

    CMP AL, 2
    JE Option2

    CMP AL, 3
    JE Option3

    CMP AL, 4
    JE Option4

    CMP AL, 5
    JE ExitProgram

    MOV AH, 09H
    LEA DX, INVALIDOPTION
    INT 21H

    JMP MainMenuLoop


; =========================================================
; [MEMBER 1 WORK] - OPTION HANDLERS
; =========================================================

Option1:
    CALL GetPrincipalAndMonths    ; 调用 Member 2 输入
    CALL CalculateInterest        ; 调用计算
    
    MOV AH, 09H
    LEA DX, TOTALMSG
    INT 21H

    MOV AX, totalInterest
    CALL PrintCurrencyRM          ; 输出标准格式金额
    JMP MainMenuLoop

Option2:
    CALL GetPrincipalAndMonths    ; 调用 Member 2 输入
    CALL CalculateInterest        ; 调用计算

    MOV AH, 09H
    LEA DX, TAXMSG
    INT 21H

    MOV AX, taxDeduction
    CALL PrintCurrencyRM

    MOV AH, 09H
    LEA DX, NETMSG
    INT 21H

    MOV AX, netInterest
    CALL PrintCurrencyRM
    JMP MainMenuLoop

Option3:
    CALL GetPrincipalAndMonths    ; 调用 Member 2 输入
    CALL CalculateInterest        ; 调用计算

    MOV AH, 09H
    LEA DX, MONTHLYMSG
    INT 21H

    MOV AX, monthlyPayout
    CALL PrintCurrencyRM
    JMP MainMenuLoop

Option4:
    CALL GetPrincipalAndMonths    ; 调用 Member 2 输入
    CALL CalculateInterest        ; 调用计算
    CALL BankAccountSummary       ; 调用 Member 3 Summary 显示
    JMP MainMenuLoop

ExitProgram:
    MOV AH, 4CH
    INT 21H
MAIN ENDP


; =========================================================
; [MEMBER 1 WORK] - USER LOGIN & CHECK MODULE
; =========================================================
UserLogin PROC
LoginAgain:
    MOV AH, 09H
    LEA DX, LOGINMSG
    INT 21H

    MOV SI, 0

ReadID:
    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JE CheckID

    MOV USERID[SI], AL
    INC SI

    CMP SI, 4
    JL ReadID

WaitEnter:
    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE WaitEnter

CheckID:
    LEA SI, USERID
    LEA DI, accountID1
    CALL CompareID
    CMP AL, 1
    JE LoginSuccess1

    LEA SI, USERID
    LEA DI, accountID2
    CALL CompareID
    CMP AL, 1
    JE LoginSuccess2

    LEA SI, USERID
    LEA DI, accountID3
    CALL CompareID
    CMP AL, 1
    JE LoginSuccess3

    MOV AH, 09H
    LEA DX, INVALIDID
    INT 21H
    JMP LoginAgain

LoginSuccess1:
    MOV currentAccount, 1
    RET
LoginSuccess2:
    MOV currentAccount, 2
    RET
LoginSuccess3:
    MOV currentAccount, 3
    RET
UserLogin ENDP


CompareID PROC
    MOV CX, 4
CompareLoop:
    MOV AL, [SI]
    CMP AL, [DI]
    JNE IDNotSame
    INC SI
    INC DI
    LOOP CompareLoop
    MOV AL, 1
    RET
IDNotSame:
    MOV AL, 0
    RET
CompareID ENDP


MainMenu PROC
    MOV AH, 09H
    LEA DX, MENUMSG
    INT 21H

    MOV AH, 01H
    INT 21H

    SUB AL, '0'
    MOV BL, AL

MenuEnter:
    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE MenuEnter

    MOV AL, BL
    RET
MainMenu ENDP


; =========================================================
; =========================================================
; [MEMBER 2 WORK] - DATA ENTRY & INPUT VALIDATION MODULE
; =========================================================
; =========================================================

GetPrincipalAndMonths PROC

GetPrincipalAgain:
    MOV AH, 09H
    LEA DX, INPUTPRINCIPAL
    INT 21H

    CALL ReadNumber

    JC PrincipalError             ; CF = 1 表示非法输入，弹错重试

    MOV principal, AX
    JMP GetMonths

PrincipalError:
    MOV AH, 09H
    LEA DX, INVALIDINPUT
    INT 21H
    JMP GetPrincipalAgain

GetMonths:
GetMonthsAgain:
    MOV AH, 09H
    LEA DX, INPUTMONTHS
    INT 21H

    CALL ReadNumber

    JC MonthsError                ; CF = 1 表示非法输入

    CMP AX, 0
    JE MonthsZero

    MOV months, AX
    RET

MonthsError:
    MOV AH, 09H
    LEA DX, INVALIDINPUT
    INT 21H
    JMP GetMonthsAgain

MonthsZero:
    MOV AH, 09H
    LEA DX, ZEROMONTH
    INT 21H
    JMP GetMonthsAgain

GetPrincipalAndMonths ENDP


; ---------------------------------------------------------
; [MEMBER 2 WORK] - READ NUMBER WITH VALIDATION
; ---------------------------------------------------------
ReadNumber PROC
    XOR BX, BX
    MOV SI, 0

ReadNumberLoop:
    MOV AH, 01H           ; 单字符带回显 (Chapter 4)
    INT 21H

    CMP AL, 0DH           ; Enter 键
    JE ReadNumberDone

    CMP AL, '-'           ; 拦截负号 '-'
    JE ReadNumberInvalid

    CMP AL, '0'           ; 拦截小于 '0' 字符
    JB ReadNumberInvalid

    CMP AL, '9'           ; 拦截大于 '9' 字符
    JA ReadNumberInvalid

    SUB AL, '0'           ; ASCII 转数值
    XOR AH, AH
    MOV SI, AX

    ; BX = BX * 10
    MOV AX, BX
    MOV DX, 10
    MUL DX

    ADD AX, SI
    JC ReadNumberInvalid  ; 防 16 位整数溢出

    MOV BX, AX
    JMP ReadNumberLoop

ReadNumberInvalid:
ClearInvalidInput:
    MOV AH, 01H
    INT 21H
    CMP AL, 0DH
    JNE ClearInvalidInput

    STC                   ; 设置 CF = 1
    RET

ReadNumberDone:
    MOV AX, BX
    CLC                   ; 清除 CF = 0
    RET
ReadNumber ENDP


; =========================================================
; =========================================================
; CALCULATE INTEREST (修正公式: P * Rate * Months / 1200)
; =========================================================
; =========================================================

CalculateInterest PROC

    ; -----------------------------------------------------
    ; [MEMBER 2 WORK] - 功能 1: 单利计算 (已彻底修正为精确公式)
    ; 公式: Total Interest = Principal * Rate * Months / 1200
    ; (或者 Principal * Rate * Months / 100 / 12)
    ; -----------------------------------------------------
    MOV AX, principal
    MOV BX, rate          ; Rate = 5%
    MUL BX                ; DX:AX = Principal * 5

    MOV BX, months
    MUL BX                ; DX:AX = (Principal * 5) * Months

    ; 先除以 100 (算百分比)
    MOV BX, 100D
    DIV BX

    ; 再除以 12 (算月份折算)
    MOV DX, 0
    MOV BX, 12D
    DIV BX                ; AX 即为最终的正确利息整数 (RM)

    MOV totalInterest, AX

    ; -----------------------------------------------------
    ; [MEMBER 3 WORK] - 高级计算 (扣税 10% 与月收益)
    ; -----------------------------------------------------
    ; Tax = Total Interest / 10
    MOV AX, totalInterest
    MOV BX, 10D
    XOR DX, DX
    DIV BX
    MOV taxDeduction, AX

    ; Net Interest = Total Interest - Tax
    MOV AX, totalInterest
    SUB AX, taxDeduction
    MOV netInterest, AX

    ; Monthly Payout = Net Interest / Months
    MOV AX, netInterest
    XOR DX, DX
    MOV BX, months
    CMP BX, 0
    JE SkipDivZero
    DIV BX
    MOV monthlyPayout, AX
    JMP CalcDone

SkipDivZero:
    MOV monthlyPayout, 0

CalcDone:
    RET
CalculateInterest ENDP


; =========================================================
; [MEMBER 3 WORK] - REPORT DISPLAY & FORMATTED MONEY PRINTING
; =========================================================

BankAccountSummary PROC
    MOV AH, 09H
    LEA DX, TITLEBM
    INT 21H

    ; 1. 本金显示
    MOV AH, 09H
    LEA DX, PRINCIPALM
    INT 21H
    MOV AX, principal
    CALL PrintCurrencyRM

    ; 2. 总利息
    MOV AH, 09H
    LEA DX, SIMINTM
    INT 21H
    MOV AX, totalInterest
    CALL PrintCurrencyRM

    ; 3. 扣税
    MOV AH, 09H
    LEA DX, TAXM
    INT 21H
    MOV AX, taxDeduction
    CALL PrintCurrencyRM

    ; 4. 税后净利息
    MOV AH, 09H
    LEA DX, NETM
    INT 21H
    MOV AX, netInterest
    CALL PrintCurrencyRM

    ; 5. 每月收益
    MOV AH, 09H
    LEA DX, MONTHM
    INT 21H
    MOV AX, monthlyPayout
    CALL PrintCurrencyRM

    MOV AH, 09H
    LEA DX, NL
    INT 21H
    RET
BankAccountSummary ENDP


; ---------------------------------------------------------
; 格式化打印整数金额并在末尾自动补齐 ".00"
; ---------------------------------------------------------
PrintCurrencyRM PROC
    PUSH AX
    PUSH DX

    CALL PrintNumber      ; 打印整数部分

    ; 打印 ".00"
    MOV DL, '.'
    MOV AH, 02H
    INT 21H
    MOV DL, '0'
    INT 21H
    MOV DL, '0'
    INT 21H

    POP DX
    POP AX
    RET
PrintCurrencyRM ENDP


PrintNumber PROC
    CMP AX, 0
    JNE ConvertNumber

    MOV DL, '0'
    MOV AH, 02H
    INT 21H
    RET

ConvertNumber:
    MOV BX, 10
    MOV SI, 0

ConvertLoop:
    XOR DX, DX
    DIV BX
    MOV DIGITS[SI], DL
    INC SI
    CMP AX, 0
    JNE ConvertLoop

PrintLoop:
    DEC SI
    MOV DL, DIGITS[SI]
    ADD DL, '0'
    MOV AH, 02H
    INT 21H
    CMP SI, 0
    JNE PrintLoop
    RET
PrintNumber ENDP

END MAIN
