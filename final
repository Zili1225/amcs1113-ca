.MODEL SMALL
.STACK 100

.DATA

; =========================================================
; ACCOUNT DATA
; =========================================================

accountIDs       DB 'A','0','0','1', 8 DUP(?)
accountPasswords DB '1','2','3','4', 8 DUP(?)

accountCount     DB 1
currentAccount   DB 0

USERID           DB 4 DUP(?)
PASSWORD         DB 4 DUP(?)

LOGINIDBUF       DB 4 DUP(?)
LOGINPASSBUF     DB 4 DUP(?)


; =========================================================
; BANK DATA
; =========================================================

principal        DW 0
rate             DW 5
months           DW 0


; =========================================================
; MONEY DATA
;
; Example:
;
; RM1000.00
;
; totalInterestRM  = 1000
; totalInterestDec = 0
;
; =========================================================

totalInterestRM       DW 0
totalInterestDec      DW 0

taxRM                 DW 0
taxDec                DW 0

netInterestRM         DW 0
netInterestDec        DW 0

monthlyPayoutRM       DW 0
monthlyPayoutDec      DW 0


; =========================================================
; 32-BIT TEMPORARY VALUE
;
; Using two DW instead of DD
;
; HIGH : LOW
; =========================================================

workLow              DW 0
workHigh             DW 0

quotientLow          DW 0
quotientHigh         DW 0

remainderValue       DW 0

tempLow              DW 0
tempHigh             DW 0


; =========================================================
; NUMBER BUFFER
; =========================================================

DIGITS               DB 6 DUP(?)


; =========================================================
; LOGIN
; =========================================================

LOGIN_TITLE      DB 13,10
                 DB "========================================",13,10
                 DB "                 LOGIN",13,10
                 DB "========================================",13,10
                 DB "1. Login",13,10
                 DB "2. Register Account",13,10
                 DB "3. End System",13,10
                 DB "========================================",13,10
                 DB "Enter your option: $"

LOGIN_ID         DB 13,10
                 DB "Enter User ID: $"

LOGIN_PASS       DB 13,10
                 DB "Enter Password: $"

LOGIN_ERROR      DB 13,10
                 DB "ERROR: Invalid User ID or Password!",13,10
                 DB "Please try again.",13,10,"$"

LOGIN_SUCCESS    DB 13,10
                 DB "LOGIN SUCCESSFUL!",13,10
                 DB "Welcome to the Bank Account System.",13,10,"$"

INVALIDLOGINOPTION DB 13,10
                   DB "ERROR: Invalid option!",13,10,"$"


; =========================================================
; REGISTER
; =========================================================

CREATE_TITLE     DB 13,10
                 DB "========================================",13,10
                 DB "          CREATE ACCOUNT",13,10
                 DB "========================================",13,10,"$"

CREATE_ID        DB "Enter User ID (4 characters): $"

CREATE_PASS      DB 13,10
                 DB "Enter Password (4 characters): $"

ACCOUNT_SUCCESS  DB 13,10
                 DB "ACCOUNT CREATED SUCCESSFULLY!",13,10,"$"

ACCOUNT_FULL     DB 13,10
                 DB "ERROR: Maximum 3 accounts reached!",13,10,"$"


; =========================================================
; MAIN MENU
; =========================================================

MENUMSG          DB 13,10
                 DB "========================================",13,10
                 DB "              MAIN MENU",13,10
                 DB "========================================",13,10
                 DB "1. Calculate Total Interest",13,10
                 DB "2. Calculate Net Interest",13,10
                 DB "3. Monthly Payout",13,10
                 DB "4. Bank Account Summary",13,10
                 DB "5. Exit",13,10
                 DB "========================================",13,10
                 DB "Enter your option: $"

INVALIDOPTION    DB 13,10
                 DB "ERROR: Invalid option!",13,10,"$"


; =========================================================
; INPUT
; =========================================================

INPUTPRINCIPAL   DB 13,10
                 DB "Enter Principal Amount (RM): $"

INPUTMONTHS      DB 13,10
                 DB "Enter Number of Months: $"

INVALIDINPUT     DB 13,10
                 DB "ERROR: Invalid input!",13,10
                 DB "Please enter numbers only and no negative value.",13,10,"$"

ZEROMONTH        DB 13,10
                 DB "ERROR: Number of months cannot be 0!",13,10,"$"


; =========================================================
; RESULT
; =========================================================

RESULTTITLE      DB 13,10
                 DB "============================",13,10
                 DB "           RESULT",13,10
                 DB "============================",13,10,"$"

TOTALMSG         DB "Total Interest : RM $"

TAXMSG           DB 13,10
                 DB "Tax Deduction (10%) : RM $"

NETMSG           DB 13,10
                 DB "Net Interest : RM $"

MONTHLYMSG       DB 13,10
                 DB "Monthly Payout : RM $"


; =========================================================
; BANK ACCOUNT SUMMARY
; =========================================================

TITLEBM          DB 13,10
                 DB "========================================",13,10
                 DB "       BANK ACCOUNT SUMMARY",13,10
                 DB "========================================$"

PRINCIPALM       DB 13,10
                 DB "Principal Amount : RM $"

SIMINTM          DB 13,10
                 DB "Total Interest   : RM $"

TAXM             DB 13,10
                 DB "Tax (10%)        : RM $"

NETM             DB 13,10
                 DB "Net Interest     : RM $"

MONTHM           DB 13,10
                 DB "Monthly Payout   : RM $"

NL               DB 13,10,"$"


.CODE


; =========================================================
; MAIN
; =========================================================

MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

    CALL UserLogin


MainMenuLoop:

    CALL MainMenu

    CMP AL, 1
    JNE CheckOption2
    JMP DoOption1


CheckOption2:

    CMP AL, 2
    JNE CheckOption3
    JMP DoOption2


CheckOption3:

    CMP AL, 3
    JNE CheckOption4
    JMP DoOption3


CheckOption4:

    CMP AL, 4
    JNE CheckOption5
    JMP DoOption4


CheckOption5:

    CMP AL, 5
    JNE InvalidMainOption
    JMP ReturnToLogin


InvalidMainOption:

    MOV AH, 09H
    LEA DX, INVALIDOPTION
    INT 21H

    JMP MainMenuLoop


; =========================================================
; OPTION 1
; TOTAL INTEREST
; =========================================================

DoOption1:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    CALL DisplayResultTitle

    MOV AH, 09H
    LEA DX, TOTALMSG
    INT 21H

    MOV AX, totalInterestRM
    MOV DX, totalInterestDec

    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 2
; NET INTEREST
; =========================================================

DoOption2:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    CALL DisplayResultTitle

    MOV AH, 09H
    LEA DX, TAXMSG
    INT 21H

    MOV AX, taxRM
    MOV DX, taxDec

    CALL PrintMoney


    MOV AH, 09H
    LEA DX, NETMSG
    INT 21H

    MOV AX, netInterestRM
    MOV DX, netInterestDec

    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 3
; MONTHLY PAYOUT
; =========================================================

DoOption3:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    CALL DisplayResultTitle

    MOV AH, 09H
    LEA DX, MONTHLYMSG
    INT 21H

    MOV AX, monthlyPayoutRM
    MOV DX, monthlyPayoutDec

    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 4
; BANK ACCOUNT SUMMARY
; =========================================================

DoOption4:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest
    CALL BankAccountSummary

    JMP MainMenuLoop


; =========================================================
; OPTION 5
; RETURN TO LOGIN
; =========================================================

ReturnToLogin:

    CALL UserLogin

    JMP MainMenuLoop

MAIN ENDP


; =========================================================
; CREATE ACCOUNT
; =========================================================

CreateAccount PROC

    MOV AL, accountCount

    CMP AL, 3
    JNE CreateAccountContinue

    JMP AccountFull


CreateAccountContinue:

    MOV AH, 09H
    LEA DX, CREATE_TITLE
    INT 21H


; =========================================================
; USER ID
; =========================================================

    MOV AH, 09H
    LEA DX, CREATE_ID
    INT 21H

    MOV SI, 0


CreateIDLoop:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE StoreCreateID

    JMP CreateIDLoop


StoreCreateID:

    MOV USERID[SI], AL

    INC SI

    CMP SI, 4
    JNE CreateIDLoop


CreateIDEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE CreateIDEnter


; =========================================================
; PASSWORD
; =========================================================

    MOV AH, 09H
    LEA DX, CREATE_PASS
    INT 21H

    MOV SI, 0


CreatePasswordLoop:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE StoreCreatePassword

    JMP CreatePasswordLoop


StoreCreatePassword:

    MOV PASSWORD[SI], AL

    INC SI

    CMP SI, 4
    JNE CreatePasswordLoop


CreatePasswordEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE CreatePasswordEnter


; =========================================================
; STORE USER ID
; =========================================================

    MOV AL, accountCount
    XOR AH, AH

    MOV BL, 4
    MUL BL

    MOV DI, AX
    MOV SI, 0


StoreIDLoop:

    MOV AL, USERID[SI]
    MOV accountIDs[DI], AL

    INC SI
    INC DI

    CMP SI, 4
    JNE StoreIDLoop


; =========================================================
; STORE PASSWORD
; =========================================================

    MOV AL, accountCount
    XOR AH, AH

    MOV BL, 4
    MUL BL

    MOV DI, AX
    MOV SI, 0


StorePasswordLoop:

    MOV AL, PASSWORD[SI]
    MOV accountPasswords[DI], AL

    INC SI
    INC DI

    CMP SI, 4
    JNE StorePasswordLoop


    INC accountCount

    MOV AH, 09H
    LEA DX, ACCOUNT_SUCCESS
    INT 21H

    RET


AccountFull:

    MOV AH, 09H
    LEA DX, ACCOUNT_FULL
    INT 21H

    RET

CreateAccount ENDP


; =========================================================
; USER LOGIN
; =========================================================

UserLogin PROC


LoginPage:

    MOV AH, 09H
    LEA DX, LOGIN_TITLE
    INT 21H

    MOV AH, 01H
    INT 21H

    CMP AL, '1'
    JNE LoginCheck2

    JMP StartLogin


LoginCheck2:

    CMP AL, '2'
    JNE LoginCheck3

    JMP RegisterChoice


LoginCheck3:

    CMP AL, '3'
    JNE InvalidLoginChoice

    JMP EndSystem


InvalidLoginChoice:

    MOV AH, 09H
    LEA DX, INVALIDLOGINOPTION
    INT 21H

    JMP LoginPage


; =========================================================
; REGISTER
; =========================================================

RegisterChoice:

WaitRegisterEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE WaitRegisterEnter

    CALL CreateAccount

    JMP LoginPage


; =========================================================
; LOGIN
; =========================================================

StartLogin:

WaitLoginEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE WaitLoginEnter


; =========================================================
; READ USER ID
; =========================================================

    MOV AH, 09H
    LEA DX, LOGIN_ID
    INT 21H

    MOV SI, 0


ReadLoginID:

    MOV AH, 01H
    INT 21H

    MOV LOGINIDBUF[SI], AL

    INC SI

    CMP SI, 4
    JNE ReadLoginID


LoginIDEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE LoginIDEnter


; =========================================================
; COPY LOGIN ID
; =========================================================

    MOV SI, 0


CopyLoginID:

    MOV AL, LOGINIDBUF[SI]
    MOV USERID[SI], AL

    INC SI

    CMP SI, 4
    JNE CopyLoginID


; =========================================================
; SEARCH ACCOUNT
; =========================================================

    MOV BL, 0


SearchAccount:

    MOV AL, BL

    CMP AL, accountCount
    JB SearchAccountValid

    JMP LoginError


SearchAccountValid:

    MOV AL, BL
    XOR AH, AH

    MOV DL, 4
    MUL DL

    MOV DI, AX
    MOV SI, 0


CompareLoginID:

    MOV AL, USERID[SI]

    CMP AL, accountIDs[DI]
    JE IDCharacterOK

    JMP NextAccount


IDCharacterOK:

    INC SI
    INC DI

    CMP SI, 4
    JNE CompareLoginID

    MOV currentAccount, BL

    JMP ReadLoginPassword


NextAccount:

    INC BL

    JMP SearchAccount


; =========================================================
; READ PASSWORD
; =========================================================

ReadLoginPassword:

    MOV AH, 09H
    LEA DX, LOGIN_PASS
    INT 21H

    MOV SI, 0


ReadPasswordLoop:

    MOV AH, 01H
    INT 21H

    MOV LOGINPASSBUF[SI], AL

    INC SI

    CMP SI, 4
    JNE ReadPasswordLoop


LoginPasswordEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE LoginPasswordEnter


; =========================================================
; COPY PASSWORD
; =========================================================

    MOV SI, 0


CopyLoginPassword:

    MOV AL, LOGINPASSBUF[SI]
    MOV PASSWORD[SI], AL

    INC SI

    CMP SI, 4
    JNE CopyLoginPassword


; =========================================================
; CHECK PASSWORD
; =========================================================

    MOV AL, currentAccount
    XOR AH, AH

    MOV BL, 4
    MUL BL

    MOV DI, AX
    MOV SI, 0


ComparePasswordLoop:

    MOV AL, PASSWORD[SI]

    CMP AL, accountPasswords[DI]
    JE PasswordCharacterOK

    JMP LoginError


PasswordCharacterOK:

    INC SI
    INC DI

    CMP SI, 4
    JNE ComparePasswordLoop


    MOV AH, 09H
    LEA DX, LOGIN_SUCCESS
    INT 21H

    RET


; =========================================================
; LOGIN ERROR
; =========================================================

LoginError:

    MOV AH, 09H
    LEA DX, LOGIN_ERROR
    INT 21H

    JMP LoginPage


; =========================================================
; END SYSTEM
; =========================================================

EndSystem:

    MOV AH, 4CH
    INT 21H

UserLogin ENDP


; =========================================================
; MAIN MENU
; =========================================================

MainMenu PROC

    MOV AH, 09H
    LEA DX, MENUMSG
    INT 21H

    MOV AH, 01H
    INT 21H

    SUB AL, '0'

    MOV BL, AL


MainMenuWaitEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE MainMenuWaitEnter

    MOV AL, BL

    RET

MainMenu ENDP


; =========================================================
; GET PRINCIPAL AND MONTHS
; =========================================================

GetPrincipalAndMonths PROC


GetPrincipalAgain:

    MOV AH, 09H
    LEA DX, INPUTPRINCIPAL
    INT 21H

    CALL ReadNumber

    JNC PrincipalValid

    JMP PrincipalError


PrincipalValid:

    MOV principal, AX

    JMP GetMonths


PrincipalError:

    MOV AH, 09H
    LEA DX, INVALIDINPUT
    INT 21H

    JMP GetPrincipalAgain


; =========================================================
; GET MONTHS
; =========================================================

GetMonths:


GetMonthsAgain:

    MOV AH, 09H
    LEA DX, INPUTMONTHS
    INT 21H

    CALL ReadNumber

    JNC MonthsInputValid

    JMP MonthsError


MonthsInputValid:

    CMP AX, 0
    JNE MonthsNotZero

    JMP MonthsZero


MonthsNotZero:

    MOV months, AX

    RET


MonthsError:

    MOV AH, 09H
    LEA DX, INVALIDINPUT
    INT 21H

    JMP GetMonthsAgain


MonthsZero:

    MOV AH, 09H
    LEA DX, ZEROMONTH
    INT 21H

    JMP GetMonthsAgain

GetPrincipalAndMonths ENDP


; =========================================================
; READ NUMBER
;
; AX = number
;
; CF = 0 valid
; CF = 1 invalid
;
; =========================================================

ReadNumber PROC

    XOR BX, BX


ReadNumberLoop:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JE ReadNumberDone


; =========================================================
; CHECK NEGATIVE
; =========================================================

    CMP AL, '-'
    JNE CheckDigit

    JMP ReadNumberInvalid


; =========================================================
; CHECK DIGIT
; =========================================================

CheckDigit:

    CMP AL, '0'
    JAE CheckDigitUpper

    JMP ReadNumberInvalid


CheckDigitUpper:

    CMP AL, '9'
    JBE ValidDigit

    JMP ReadNumberInvalid


; =========================================================
; ASCII TO NUMBER
; =========================================================

ValidDigit:

    SUB AL, '0'

    XOR AH, AH

    MOV DI, AX


; =========================================================
; BX = BX x 10
; =========================================================

    MOV AX, BX

    MOV DX, 10

    MUL DX

    CMP DX, 0
    JE NoMultiplyOverflow

    JMP ReadNumberInvalid


NoMultiplyOverflow:

    ADD AX, DI

    JNC NoAddOverflow

    JMP ReadNumberInvalid


NoAddOverflow:

    MOV BX, AX

    JMP ReadNumberLoop


; =========================================================
; INVALID
; =========================================================

ReadNumberInvalid:

ClearInputLoop:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE ClearInputLoop

    STC

    RET


; =========================================================
; VALID
; =========================================================

ReadNumberDone:

    MOV AX, BX

    CLC

    RET

ReadNumber ENDP


; =========================================================
; CALCULATE INTEREST
;
; IMPORTANT FORMULA:
;
; Total Interest
; = Principal x Rate x Months / 12
;
; Because rate is 5%:
;
; Principal x 5 x Months / 12
;
; The result here is stored as CENTS.
;
; Example:
;
; Principal = 10000
; Rate      = 5
; Months    = 24
;
; 10000 x 5 x 24 = 1200000
;
; 1200000 / 12 = 100000 cents
;
; 100000 cents = RM1000.00
;
; =========================================================

CalculateInterest PROC


; =========================================================
; CLEAR OLD RESULTS
; =========================================================

    MOV totalInterestRM, 0
    MOV totalInterestDec, 0

    MOV taxRM, 0
    MOV taxDec, 0

    MOV netInterestRM, 0
    MOV netInterestDec, 0

    MOV monthlyPayoutRM, 0
    MOV monthlyPayoutDec, 0


; =========================================================
; PRINCIPAL x RATE
; =========================================================

    MOV AX, principal

    MOV BX, rate

    MUL BX

    MOV workLow, AX
    MOV workHigh, DX


; =========================================================
; x MONTHS
; =========================================================

    MOV BX, months

    CALL Mul32By16


; =========================================================
; / 12
;
; Result = TOTAL INTEREST IN CENTS
;
; DO NOT multiply by 100 here.
; =========================================================

    MOV BX, 12

    CALL Div32By16


; =========================================================
; SAVE TOTAL CENTS
; =========================================================

    MOV workLow, AX
    MOV workHigh, DX


; =========================================================
; CENTS / 100
;
; Quotient = RM
; Remainder = decimal cents
; =========================================================

    MOV BX, 100

    CALL Div32By16

    MOV totalInterestRM, AX

    MOV AX, remainderValue
    MOV totalInterestDec, AX


; =========================================================
; TAX
;
; Tax = Total Interest x 10%
; =========================================================

; Convert RM back to cents

    MOV AX, totalInterestRM

    MOV workLow, AX
    MOV workHigh, 0

    MOV BX, 100

    CALL Mul32By16


; Add decimal cents

    MOV AX, workLow

    ADD AX, totalInterestDec

    MOV workLow, AX

    MOV AX, workHigh

    ADC AX, 0

    MOV workHigh, AX


; =========================================================
; / 10
; =========================================================

    MOV BX, 10

    CALL Div32By16


    MOV workLow, AX
    MOV workHigh, DX


; =========================================================
; / 100
; =========================================================

    MOV BX, 100

    CALL Div32By16

    MOV taxRM, AX

    MOV AX, remainderValue
    MOV taxDec, AX


; =========================================================
; NET INTEREST
;
; Net = Total - Tax
; =========================================================

    MOV AX, totalInterestDec

    SUB AX, taxDec

    JNC NetNoBorrow

; Borrow 1 RM

    ADD AX, 100

    MOV netInterestDec, AX

    MOV AX, totalInterestRM

    SUB AX, taxRM

    DEC AX

    MOV netInterestRM, AX

    JMP CalculateMonthly


NetNoBorrow:

    MOV netInterestDec, AX

    MOV AX, totalInterestRM

    SUB AX, taxRM

    MOV netInterestRM, AX


; =========================================================
; MONTHLY PAYOUT
;
; Monthly = Net Interest / Months
; =========================================================

CalculateMonthly:

; Convert RM to cents

    MOV AX, netInterestRM

    MOV workLow, AX
    MOV workHigh, 0

    MOV BX, 100

    CALL Mul32By16


; Add decimal cents

    MOV AX, workLow

    ADD AX, netInterestDec

    MOV workLow, AX

    MOV AX, workHigh

    ADC AX, 0

    MOV workHigh, AX


; =========================================================
; / MONTHS
; =========================================================

    MOV BX, months

    CALL Div32By16


    MOV workLow, AX
    MOV workHigh, DX


; =========================================================
; / 100
; =========================================================

    MOV BX, 100

    CALL Div32By16

    MOV monthlyPayoutRM, AX

    MOV AX, remainderValue
    MOV monthlyPayoutDec, AX


    RET

CalculateInterest ENDP


; =========================================================
; 32-BIT x 16-BIT
;
; Input:
;
; workHigh:workLow
; BX = multiplier
;
; Output:
;
; workHigh:workLow
;
; =========================================================

Mul32By16 PROC

    MOV AX, workLow

    MUL BX

    MOV tempLow, AX
    MOV tempHigh, DX


    MOV AX, workHigh

    MUL BX

    ADD AX, tempHigh

    MOV workHigh, AX

    MOV AX, tempLow

    MOV workLow, AX

    RET

Mul32By16 ENDP


; =========================================================
; 32-BIT / 16-BIT
;
; Input:
;
; workHigh:workLow
; BX = divisor
;
; Output:
;
; DX:AX = quotient
; remainderValue = remainder
;
; =========================================================

Div32By16 PROC

    MOV AX, workHigh

    XOR DX, DX

    DIV BX

    MOV quotientHigh, AX
    MOV remainderValue, DX


    MOV AX, workLow

    MOV DX, remainderValue

    DIV BX

    MOV quotientLow, AX
    MOV remainderValue, DX


    MOV AX, quotientLow

    MOV DX, quotientHigh

    RET

Div32By16 ENDP


; =========================================================
; DISPLAY RESULT TITLE
; =========================================================

DisplayResultTitle PROC

    MOV AH, 09H

    LEA DX, RESULTTITLE

    INT 21H

    RET

DisplayResultTitle ENDP


; =========================================================
; BANK ACCOUNT SUMMARY
; =========================================================

BankAccountSummary PROC

    MOV AH, 09H
    LEA DX, TITLEBM
    INT 21H


; =========================================================
; PRINCIPAL
; =========================================================

    MOV AH, 09H
    LEA DX, PRINCIPALM
    INT 21H

    MOV AX, principal

    CALL PrintNumber

    MOV DL, '.'

    MOV AH, 02H

    INT 21H

    MOV AX, 0

    CALL PrintTwoDigits


; =========================================================
; TOTAL INTEREST
; =========================================================

    MOV AH, 09H
    LEA DX, SIMINTM
    INT 21H

    MOV AX, totalInterestRM
    MOV DX, totalInterestDec

    CALL PrintMoney


; =========================================================
; TAX
; =========================================================

    MOV AH, 09H
    LEA DX, TAXM
    INT 21H

    MOV AX, taxRM
    MOV DX, taxDec

    CALL PrintMoney


; =========================================================
; NET INTEREST
; =========================================================

    MOV AH, 09H
    LEA DX, NETM
    INT 21H

    MOV AX, netInterestRM
    MOV DX, netInterestDec

    CALL PrintMoney


; =========================================================
; MONTHLY PAYOUT
; =========================================================

    MOV AH, 09H
    LEA DX, MONTHM
    INT 21H

    MOV AX, monthlyPayoutRM
    MOV DX, monthlyPayoutDec

    CALL PrintMoney


    MOV AH, 09H
    LEA DX, NL
    INT 21H

    RET

BankAccountSummary ENDP


; =========================================================
; PRINT MONEY
;
; AX = RM
; DX = decimal
;
; =========================================================

PrintMoney PROC

    MOV DI, DX

    CALL PrintNumber


    MOV DL, '.'

    MOV AH, 02H

    INT 21H


    MOV AX, DI

    CALL PrintTwoDigits

    RET

PrintMoney ENDP


; =========================================================
; PRINT NUMBER
;
; AX = integer
; =========================================================

PrintNumber PROC

    CMP AX, 0
    JNE NumberNotZero


    MOV DL, '0'

    MOV AH, 02H

    INT 21H

    RET


NumberNotZero:

    MOV BX, 10

    MOV SI, 0


ConvertLoop:

    XOR DX, DX

    DIV BX

    MOV DIGITS[SI], DL

    INC SI

    CMP AX, 0
    JNE ConvertLoop


PrintLoop:

    DEC SI

    MOV DL, DIGITS[SI]

    ADD DL, '0'

    MOV AH, 02H

    INT 21H

    CMP SI, 0
    JNE PrintLoop

    RET

PrintNumber ENDP


; =========================================================
; PRINT TWO DIGITS
;
; AX = 0 - 99
;
; =========================================================

PrintTwoDigits PROC

    XOR DX, DX

    MOV BX, 10

    DIV BX

    MOV SI, DX


    ADD AL, '0'

    MOV DL, AL

    MOV AH, 02H

    INT 21H


    MOV DX, SI

    ADD DL, '0'

    MOV AH, 02H

    INT 21H

    RET

PrintTwoDigits ENDP


END MAIN
