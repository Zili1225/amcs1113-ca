.MODEL SMALL
.STACK 100

.DATA

; =========================================================
; ACCOUNT DATA
; =========================================================

accountID1      DB "A001",'$'
accountID2      DB "A002",'$'
accountID3      DB "A003",'$'

password1       DB "1234"
password2       DB "5678"
password3       DB "9999"

USERID          DB 4 DUP(?)
PASSWORD        DB 4 DUP(?)

accountCount    DB 3
currentAccount  DB 0

; =========================================================
; VARIABLES
; =========================================================

principal       DW 0
rate            DW 5
months          DW 0

totalInterest   DW 0
taxDeduction    DW 0
netInterest     DW 0
monthlyPayout   DW 0

DIGITS          DB 6 DUP(?)

; =========================================================
; LOGIN MESSAGES
; =========================================================

LOGINMSG        DB 13,10
                DB "========================================",13,10
                DB "          BANK ACCOUNT SYSTEM",13,10
                DB "========================================",13,10
                DB "Enter User ID: $"

PASSWORDMSG     DB 13,10
                DB "Enter Password: $"

LOGINERROR      DB 13,10
                DB "ERROR: Invalid User ID or Password!",13,10
                DB "Please try again.",13,10,"$"

LOGINSUCCESS    DB 13,10
                DB "LOGIN SUCCESSFUL!",13,10
                DB "Welcome to the Bank Account System.",13,10,"$"

; =========================================================
; MENU MESSAGES
; =========================================================

MENUMSG         DB 13,10
                DB 13,10
                DB "========================================",13,10
                DB "              MAIN MENU",13,10
                DB "========================================",13,10
                DB "1. Calculate Total Interest",13,10
                DB "2. Calculate Net Interest",13,10
                DB "3. Monthly Payout",13,10
                DB "4. Bank Account Summary",13,10
                DB "5. Exit",13,10
                DB "========================================",13,10
                DB "Enter your option: $"

INVALIDOPTION   DB 13,10
                DB "ERROR: Invalid option!",13,10,"$"

; =========================================================
; INPUT MESSAGES
; =========================================================

INPUTPRINCIPAL  DB 13,10
                DB "Enter Principal Amount (RM): $"

INPUTMONTHS     DB 13,1
                DB "Enter Number of Months: $"

INVALIDINPUT    DB 13,10
                DB "ERROR: Invalid input!",13,10
                DB "Please enter numbers only and no negative value.",13,10,"$"

ZEROMONTH       DB 13,10
                DB "ERROR: Number of months cannot be 0!",13,10,"$"

; =========================================================
; RESULT MESSAGES
; =========================================================

TOTALMSG        DB 13,10
                DB "Total Interest : RM $"

TAXMSG          DB 13,10
                DB "Tax Deduction (10%) : RM $"

NETMSG          DB 13,10
                DB "Net Interest : RM $"

MONTHLYMSG      DB 13,10
                DB "Monthly Payout : RM $"

; =========================================================
; BANK ACCOUNT SUMMARY
; =========================================================

TITLEBM         DB 13,10
                DB "========================================",13,10
                DB "       BANK ACCOUNT SUMMARY",13,10
                DB "========================================$"

PRINCIPALM      DB 13,10
                DB "Principal Amount : RM $"

SIMINTM         DB 13,10
                DB "Total Interest   : RM $"

TAXM            DB 13,10
                DB "Tax (10%)        : RM $"

NETM            DB 13,10
                DB "Net Interest     : RM $"

MONTHM          DB 13,10
                DB "Monthly Payout   : RM $"

NL              DB 13,10,"$"


.CODE

MAIN PROC

    MOV AX, @DATA
    MOV DS, AX

    ; =====================================================
    ; LOGIN
    ; =====================================================

    CALL UserLogin


; =========================================================
; MAIN MENU LOOP
; =========================================================

MainMenuLoop:

    CALL MainMenu

    CMP AL, 1
    JE Option1

    CMP AL, 2
    JE Option2

    CMP AL, 3
    JE Option3

    CMP AL, 4
    JE Option4

    CMP AL, 5
    JE ExitProgram

    ; Invalid option
    MOV AH, 09H
    LEA DX, INVALIDOPTION
    INT 21H

    JMP MainMenuLoop


; =========================================================
; OPTION 1
; CALCULATE TOTAL INTEREST
; =========================================================

Option1:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    MOV AH, 09H
    LEA DX, TOTALMSG
    INT 21H

    MOV AX, totalInterest
    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 2
; CALCULATE NET INTEREST
; SHOW TAX
; =========================================================

Option2:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    MOV AH, 09H
    LEA DX, TAXMSG
    INT 21H

    MOV AX, taxDeduction
    CALL PrintMoney

    MOV AH, 09H
    LEA DX, NETMSG
    INT 21H

    MOV AX, netInterest
    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 3
; MONTHLY PAYOUT
; =========================================================

Option3:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest

    MOV AH, 09H
    LEA DX, MONTHLYMSG
    INT 21H

    MOV AX, monthlyPayout
    CALL PrintMoney

    JMP MainMenuLoop


; =========================================================
; OPTION 4
; BANK ACCOUNT SUMMARY
; =========================================================

Option4:

    CALL GetPrincipalAndMonths
    CALL CalculateInterest
    CALL BankAccountSummary

    JMP MainMenuLoop


; =========================================================
; OPTION 5
; EXIT
; =========================================================

ExitProgram:

    MOV AH, 4CH
    INT 21H

MAIN ENDP


; =========================================================
; USER LOGIN
; USER ID + PASSWORD
; =========================================================

UserLogin PROC


LoginAgain:

    ; -----------------------------------------------------
    ; Display Login
    ; -----------------------------------------------------

    MOV AH, 09H
    LEA DX, LOGINMSG
    INT 21H


    ; -----------------------------------------------------
    ; Read User ID
    ; -----------------------------------------------------

    MOV SI, 0

ReadID:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JE CheckID

    MOV USERID[SI], AL

    INC SI

    CMP SI, 4
    JL ReadID


WaitIDEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE WaitIDEnter


; =========================================================
; CHECK USER ID
; =========================================================

CheckID:

    ; Check A001
    LEA SI, USERID
    LEA DI, accountID1

    CALL CompareID

    CMP AL, 1
    JE CheckPassword1


    ; Check A002
    LEA SI, USERID
    LEA DI, accountID2

    CALL CompareID

    CMP AL, 1
    JE CheckPassword2


    ; Check A003
    LEA SI, USERID
    LEA DI, accountID3

    CALL CompareID

    CMP AL, 1
    JE CheckPassword3


    ; -----------------------------------------------------
    ; Invalid User ID
    ; -----------------------------------------------------

    MOV AH, 09H
    LEA DX, LOGINERROR
    INT 21H

    JMP LoginAgain


; =========================================================
; PASSWORD FOR A001
; =========================================================

CheckPassword1:

    MOV currentAccount, 1

    LEA DI, password1

    JMP ReadPassword


; =========================================================
; PASSWORD FOR A002
; =========================================================

CheckPassword2:

    MOV currentAccount, 2

    LEA DI, password2

    JMP ReadPassword


; =========================================================
; PASSWORD FOR A003
; =========================================================

CheckPassword3:

    MOV currentAccount, 3

    LEA DI, password3


; =========================================================
; READ PASSWORD
; =========================================================

ReadPassword:

    MOV AH, 09H
    LEA DX, PASSWORDMSG
    INT 21H

    MOV SI, 0

ReadPasswordLoop:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JE CheckPassword

    MOV PASSWORD[SI], AL

    INC SI

    CMP SI, 4
    JL ReadPasswordLoop


WaitPasswordEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE WaitPasswordEnter


; =========================================================
; CHECK PASSWORD
; =========================================================

CheckPassword:

    LEA SI, PASSWORD

    MOV CX, 4

PasswordCompareLoop:

    MOV AL, [SI]

    CMP AL, [DI]

    JNE PasswordWrong

    INC SI
    INC DI

    LOOP PasswordCompareLoop


; =========================================================
; LOGIN SUCCESSFUL
; =========================================================

    MOV AH, 09H
    LEA DX, LOGINSUCCESS
    INT 21H

    RET


; =========================================================
; PASSWORD WRONG
; =========================================================

PasswordWrong:

    MOV AH, 09H
    LEA DX, LOGINERROR
    INT 21H

    JMP LoginAgain

UserLogin ENDP


; =========================================================
; COMPARE USER ID
; SI = USERID
; DI = ACCOUNT ID
; AL = 1 SAME
; AL = 0 DIFFERENT
; =========================================================

CompareID PROC

    MOV CX, 4

CompareLoop:

    MOV AL, [SI]

    CMP AL, [DI]

    JNE IDNotSame

    INC SI
    INC DI

    LOOP CompareLoop

    MOV AL, 1

    RET


IDNotSame:

    MOV AL, 0

    RET

CompareID ENDP


; =========================================================
; MAIN MENU
; =========================================================

MainMenu PROC

    MOV AH, 09H
    LEA DX, MENUMSG
    INT 21H

    MOV AH, 01H
    INT 21H

    SUB AL, '0'

    MOV BL, AL


MenuEnter:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE MenuEnter

    MOV AL, BL

    RET

MainMenu ENDP


; =========================================================
; GET PRINCIPAL AND MONTHS
; =========================================================

GetPrincipalAndMonths PROC


; =========================================================
; PRINCIPAL
; =========================================================

GetPrincipalAgain:

    MOV AH, 09H
    LEA DX, INPUTPRINCIPAL
    INT 21H

    CALL ReadNumber

    JC PrincipalError

    MOV principal, AX

    JMP GetMonths


PrincipalError:

    MOV AH, 09H
    LEA DX, INVALIDINPUT
    INT 21H

    JMP GetPrincipalAgain


; =========================================================
; MONTHS
; =========================================================

GetMonths:

GetMonthsAgain:

    MOV AH, 09H
    LEA DX, INPUTMONTHS
    INT 21H

    CALL ReadNumber

    JC MonthsError

    CMP AX, 0
    JE MonthsZero

    MOV months, AX

    RET


MonthsError:

    MOV AH, 09H
    LEA DX, INVALIDINPUT
    INT 21H

    JMP GetMonthsAgain


MonthsZero:

    MOV AH, 09H
    LEA DX, ZEROMONTH
    INT 21H

    JMP GetMonthsAgain

GetPrincipalAndMonths ENDP


; =========================================================
; READ NUMBER WITH VALIDATION
;
; CF = 0 -> VALID
; CF = 1 -> INVALID
; =========================================================

ReadNumber PROC

    XOR BX, BX
    MOV SI, 0


ReadNumberLoop:

    MOV AH, 01H
    INT 21H


    ; ENTER
    CMP AL, 0DH
    JE ReadNumberDone


    ; Negative sign
    CMP AL, '-'
    JE ReadNumberInvalid


    ; Less than 0
    CMP AL, '0'
    JB ReadNumberInvalid


    ; Greater than 9
    CMP AL, '9'
    JA ReadNumberInvalid


    ; ASCII -> Number
    SUB AL, '0'

    XOR AH, AH


    ; Save digit
    MOV SI, AX


    ; BX * 10
    MOV AX, BX

    MOV DX, 10

    MUL DX


    ; Add digit
    ADD AX, SI

    JC ReadNumberInvalid

    MOV BX, AX

    JMP ReadNumberLoop


; =========================================================
; INVALID INPUT
; =========================================================

ReadNumberInvalid:

ClearInvalidInput:

    MOV AH, 01H
    INT 21H

    CMP AL, 0DH
    JNE ClearInvalidInput

    STC

    RET


; =========================================================
; VALID INPUT
; =========================================================

ReadNumberDone:

    MOV AX, BX

    CLC

    RET

ReadNumber ENDP


; =========================================================
; CALCULATE INTEREST
; =========================================================

CalculateInterest PROC

    ; Total Interest
    MOV AX, principal

    MOV BX, rate

    MUL BX

    MOV totalInterest, AX


    ; Tax = Total Interest / 10
    MOV AX, totalInterest

    MOV BX, 10

    XOR DX, DX

    DIV BX

    MOV taxDeduction, AX


    ; Net Interest
    MOV AX, totalInterest

    SUB AX, taxDeduction

    MOV netInterest, AX


    ; Monthly Payout
    MOV AX, netInterest

    XOR DX, DX

    MOV BX, months

    DIV BX

    MOV monthlyPayout, AX

    RET

CalculateInterest ENDP


; =========================================================
; BANK ACCOUNT SUMMARY
; =========================================================

BankAccountSummary PROC

    MOV AH, 09H
    LEA DX, TITLEBM
    INT 21H


    ; =====================================================
    ; Principal
    ; Principal is stored directly as RM
    ; =====================================================

    MOV AH, 09H
    LEA DX, PRINCIPALM
    INT 21H

    MOV AX, principal
    CALL PrintNumber

    MOV DL, '.'
    MOV AH, 02H
    INT 21H

    MOV DL, '0'
    MOV AH, 02H
    INT 21H

    MOV DL, '0'
    MOV AH, 02H
    INT 21H


    ; =====================================================
    ; Total Interest
    ; =====================================================

    MOV AH, 09H
    LEA DX, SIMINTM
    INT 21H

    MOV AX, totalInterest
    CALL PrintMoney


    ; =====================================================
    ; Tax
    ; =====================================================

    MOV AH, 09H
    LEA DX, TAXM
    INT 21H

    MOV AX, taxDeduction
    CALL PrintMoney


    ; =====================================================
    ; Net Interest
    ; =====================================================

    MOV AH, 09H
    LEA DX, NETM
    INT 21H

    MOV AX, netInterest
    CALL PrintMoney


    ; =====================================================
    ; Monthly Payout
    ; =====================================================

    MOV AH, 09H
    LEA DX, MONTHM
    INT 21H

    MOV AX, monthlyPayout
    CALL PrintMoney


    MOV AH, 09H
    LEA DX, NL
    INT 21H

    RET

BankAccountSummary ENDP


; =========================================================
; PRINT MONEY
; =========================================================

PrintMoney PROC

    XOR DX, DX

    MOV BX, 100

    DIV BX

    MOV DI, DX

    CALL PrintNumber


    MOV DL, '.'

    MOV AH, 02H

    INT 21H


    MOV AX, DI

    CALL PrintTwoDigits

    RET

PrintMoney ENDP


; =========================================================
; PRINT NUMBER
; =========================================================

PrintNumber PROC

    CMP AX, 0

    JNE ConvertNumber


    MOV DL, '0'

    MOV AH, 02H

    INT 21H

    RET


ConvertNumber:

    MOV BX, 10

    MOV SI, 0


ConvertLoop:

    XOR DX, DX

    DIV BX

    MOV DIGITS[SI], DL

    INC SI

    CMP AX, 0

    JNE ConvertLoop


PrintLoop:

    DEC SI

    MOV DL, DIGITS[SI]

    ADD DL, '0'

    MOV AH, 02H

    INT 21H

    CMP SI, 0

    JNE PrintLoop

    RET

PrintNumber ENDP


; =========================================================
; PRINT TWO DIGITS
; =========================================================

PrintTwoDigits PROC

    XOR DX, DX

    MOV BX, 10

    DIV BX

    MOV SI, DX


    ADD AL, '0'

    MOV DL, AL

    MOV AH, 02H

    INT 21H


    MOV DX, SI

    ADD DL, '0'

    MOV AH, 02H

    INT 21H

    RET

PrintTwoDigits ENDP


END MAIN
