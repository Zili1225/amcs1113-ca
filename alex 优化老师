.MODEL SMALL
.STACK 100H

; ===== 老师风格：使用 EQU 定义系统上限常量 (Chapter 6.3) =====
MAX_PRINCIPAL   EQU 9999
MAX_RATE        EQU 99
MAX_TENURE      EQU 99

.DATA
    ; ===== 共享变量 (Chapter 6.2) =====
    PRINCIPAL       DW 0          ; 本金
    RATE            DW 0          ; 年利率
    TENURE_MONTHS   DW 0          ; 存款期限(月)
    SIMPLE_INTEREST DW 0          ; [计算1] 单利
    TOTAL_MATURITY  DW 0          ; [计算2] 到期总额

    ; ===== 提示字符串 (Chapter 6.1: 0DH, 0AH 与 $ 结尾) =====
    STR_P       DB "ENTER PRINCIPAL AMOUNT (RM 1-9999): $"
    STR_R       DB "ENTER ANNUAL RATE % (1-99): $"
    STR_M       DB "ENTER TENURE IN MONTHS (1-99): $"
    STR_ERR     DB "INVALID INPUT OR OUT OF RANGE! PLEASE TRY AGAIN.$"
    
    MSG_RES1    DB "SIMPLE INTEREST IS: $"
    MSG_RES2    DB "TOTAL AT MATURITY IS: $"
    NL          DB 0DH, 0AH, "$"

.CODE

; =========================================================
; MAIN PROC (主程序入口)
; =========================================================
MAIN PROC FAR
    MOV AX, @DATA
    MOV DS, AX

    ; 1. 输入数据与校验
    CALL INPUT_DATA_PROC

    ; 2. 计算功能 1: 单利
    CALL CALC_SIMPLE_INTEREST_PROC

    ; 3. 计算功能 2: 到期总额
    CALL CALC_TOTAL_MATURITY_PROC

    ; 4. 显示计算结果 (使用 INT 21H / AH=09H)
    MOV AH, 09H
    LEA DX, MSG_RES1
    INT 21H
    MOV AX, SIMPLE_INTEREST
    CALL M2_PRINT_NUM

    MOV AH, 09H
    LEA DX, NL
    INT 21H

    MOV AH, 09H
    LEA DX, MSG_RES2
    INT 21H
    MOV AX, TOTAL_MATURITY
    CALL M2_PRINT_NUM

    MOV AH, 09H
    LEA DX, NL
    INT 21H

    ; 老师课件标准程序退出写法 (Chapter 6.1)
    MOV AX, 4C00H
    INT 21H
MAIN ENDP


; =========================================================
; 1. 数据输入与范围检测模块
; =========================================================
INPUT_DATA_PROC PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

GET_P:
    MOV AH, 09H
    LEA DX, STR_P
    INT 21H
    
    MOV CX, 1              ; Min = 1
    MOV DX, MAX_PRINCIPAL  ; Max = 9999
    CALL READ_NUM_RANGE
    JC ERR_P
    MOV PRINCIPAL, AX
    
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    JMP GET_R

ERR_P:
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    JMP GET_P

GET_R:
    MOV AH, 09H
    LEA DX, STR_R
    INT 21H
    
    MOV CX, 1              ; Min = 1
    MOV DX, MAX_RATE       ; Max = 99
    CALL READ_NUM_RANGE
    JC ERR_R
    MOV RATE, AX
    
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    JMP GET_M

ERR_R:
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    JMP GET_R

GET_M:
    MOV AH, 09H
    LEA DX, STR_M
    INT 21H
    
    MOV CX, 1              ; Min = 1
    MOV DX, MAX_TENURE     ; Max = 99
    CALL READ_NUM_RANGE
    JC ERR_M
    MOV TENURE_MONTHS, AX
    
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    JMP INPUT_DONE

ERR_M:
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    MOV AH, 09H
    LEA DX, STR_ERR
    INT 21H
    MOV AH, 09H
    LEA DX, NL
    INT 21H
    JMP GET_M

INPUT_DONE:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
INPUT_DATA_PROC ENDP


; =========================================================
; 键盘读取与范围检测 (使用 DI 计数，解决 CX 寄存器覆盖 Bug)
; 入口参数: CX = 最小值, DX = 最大值
; 出口参数: AX = 输入数值, CF = 0(成功) / CF = 1(失败)
; =========================================================
READ_NUM_RANGE PROC
    PUSH BX
    PUSH CX
    PUSH DX
    PUSH SI
    PUSH DI

    MOV SI, CX            ; SI = 最小值
    MOV DI, DX            ; DI = 最大值
    MOV BX, 0             ; BX = 累加器 (当前数值)
    MOV CX, 0             ; CX 用作字符计数值

READ_CHAR_LOOP:
    MOV AH, 01H           ; 单字符带回显输入 (Chapter 4)
    INT 21H

    CMP AL, 0DH           ; 检查 Enter 键 (CR = 0DH)
    JE CHECK_RANGE

    CMP AL, 30H           ; 小于 '0' (ASCII 30H)
    JB INPUT_ERROR
    CMP AL, 39H           ; 大于 '9' (ASCII 39H)
    JA INPUT_ERROR

    SUB AL, 30H           ; 转换为数字值 (SUB AL, 30H)
    MOV AH, 0             ; 清空高字节，AX 为新数字
    PUSH AX

    ; BX = BX * 10
    MOV AX, BX
    MOV DX, 10D
    MUL DX                ; AX = AX * 10
    JC POP_AND_ERR        ; 溢出检查

    POP DX                ; 取出刚才压栈的新数字
    ADD AX, DX            ; AX = (BX * 10) + 新数字
    JC INPUT_ERROR        ; 溢出检查

    MOV BX, AX            ; 更新 BX
    INC CX                ; 有效字符数 + 1
    JMP READ_CHAR_LOOP

POP_AND_ERR:
    POP AX                ; 平衡堆栈
    JMP INPUT_ERROR

CHECK_RANGE:
    CMP CX, 0             ; 检查是否未输入任何数字直接按 Enter
    JE INPUT_ERROR

    ; 依据无符号数比较条件跳转 (Chapter 8.3: CMP + JB/JA)
    CMP BX, SI            ; 是否小于最小值 (Min)
    JB INPUT_ERROR
    
    CMP BX, DI            ; 是否大于最大值 (Max)
    JA INPUT_ERROR

    MOV AX, BX            ; 将结果送入 AX 返回
    CLC                   ; 清除进位标志 CF = 0，表示成功
    JMP RANGE_EXIT

INPUT_ERROR:
    STC                   ; 设置进位标志 CF = 1，表示失败

RANGE_EXIT:
    POP DI
    POP SI
    POP DX
    POP CX
    POP BX
    RET
READ_NUM_RANGE ENDP


; =========================================================
; 2. 计算功能 1：单利计算 (Interest = P * R * M / 1200)
; =========================================================
CALC_SIMPLE_INTEREST_PROC PROC
    PUSH AX
    PUSH BX
    PUSH DX

    MOV AX, PRINCIPAL
    MOV BX, RATE
    MUL BX                ; DX:AX = P * R (Chapter 7.1)

    MOV BX, TENURE_MONTHS
    MUL BX                ; DX:AX = (P * R) * M

    MOV BX, 1200D
    DIV BX                ; AX = 商 (单利利息), DX = 余数 (Chapter 7.1)

    MOV SIMPLE_INTEREST, AX

    POP DX
    POP BX
    POP AX
    RET
CALC_SIMPLE_INTEREST_PROC ENDP


; =========================================================
; 3. 计算功能 2：到期总额计算 (Total = P + Interest)
; =========================================================
CALC_TOTAL_MATURITY_PROC PROC
    PUSH AX
    PUSH BX

    MOV AX, PRINCIPAL
    ADD AX, SIMPLE_INTEREST
    MOV TOTAL_MATURITY, AX

    POP BX
    POP AX
    RET
CALC_TOTAL_MATURITY_PROC ENDP


; =========================================================
; 辅助工具：多位数字输出 (遵从老师 ADD DL, 30H 风格)
; =========================================================
M2_PRINT_NUM PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

    MOV BX, 10D
    MOV CX, 0

    CMP AX, 0
    JNE M2_CONVERT
    MOV DL, '0'
    MOV AH, 02H
    INT 21H
    JMP M2_DONE

M2_CONVERT:
M2_DIV_LOOP:
    MOV DX, 0
    DIV BX                ; AX / 10, 余数在 DX
    PUSH DX               ; 保存余数
    INC CX                ; 记录位数
    CMP AX, 0
    JNE M2_DIV_LOOP

M2_PRINT_LOOP:
    POP DX
    ADD DL, 30H           ; 转换为 ASCII 字符
    MOV AH, 02H           ; 单字符显示 (Chapter 4)
    INT 21H
    LOOP M2_PRINT_LOOP

M2_DONE:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
M2_PRINT_NUM ENDP

END MAIN
