.MODEL SMALL
.STACK 100H

.DATA
    ; ===== 共享变量（组员2负责的数据） =====
    principal       DW 0          ; 本金 (如 1000)
    rate            DW 0          ; 年利率 (如 5 代表 5%)
    tenure_months   DW 0          ; 存款期限/月份 (如 12)
    simple_interest DW 0          ; [功能1] 计算出的单利利息
    total_maturity  DW 0          ; [功能2] 计算出的到期总金额

    ; ===== 提示信息字符串 =====
    msgPromptP  DB 13,10,'Enter Principal Amount ($1-9999): $'
    msgPromptR  DB 13,10,'Enter Annual Rate % (1-99): $'
    msgPromptM  DB 13,10,'Enter Tenure in Months (1-99): $'
    msgErr      DB 13,10,'[ERROR] Invalid input! Please enter digits only.$'
    
    ; ===== 计算输出调试提示 =====
    msgRes1     DB 13,10,'[Calc 1] Simple Interest: $'
    msgRes2     DB 13,10,'[Calc 2] Total at Maturity: $'

.CODE

; =========================================================
; 测试主程序 (独立的测试入口，组长合并时只需复制下方 PROC)
; =========================================================
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX

    ; 1. 调用数据输入与校验模块
    CALL INPUT_DATA_PROC

    ; 2. 调用计算功能 1：单利计算
    CALL CALC_SIMPLE_INTEREST_PROC

    ; 3. 调用计算功能 2：到期总额计算
    CALL CALC_TOTAL_MATURITY_PROC

    ; 4. 显示计算结果（调试用）
    LEA DX, msgRes1
    MOV AH, 09H
    INT 21H
    MOV AX, simple_interest
    CALL M2_PRINT_NUM

    LEA DX, msgRes2
    MOV AH, 09H
    INT 21H
    MOV AX, total_maturity
    CALL M2_PRINT_NUM

    ; 退出程序
    MOV AH, 4CH
    INT 21H
MAIN ENDP


; =========================================================
; 1. 数据输入与校验模块 (Data Entry & Input Validation)
; =========================================================
INPUT_DATA_PROC PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

GET_P:
    LEA DX, msgPromptP
    MOV AH, 09H
    INT 21H
    CALL READ_NUM_VALIDATE
    CMP AX, 0
    JE ERR_P
    MOV principal, AX
    JMP GET_R

ERR_P:
    LEA DX, msgErr
    MOV AH, 09H
    INT 21H
    JMP GET_P

GET_R:
    LEA DX, msgPromptR
    MOV AH, 09H
    INT 21H
    CALL READ_NUM_VALIDATE
    CMP AX, 0
    JE ERR_R
    MOV rate, AX
    JMP GET_M

ERR_R:
    LEA DX, msgErr
    MOV AH, 09H
    INT 21H
    JMP GET_R

GET_M:
    LEA DX, msgPromptM
    MOV AH, 09H
    INT 21H
    CALL READ_NUM_VALIDATE
    CMP AX, 0
    JE ERR_M
    MOV tenure_months, AX
    JMP INPUT_DONE

ERR_M:
    LEA DX, msgErr
    MOV AH, 09H
    INT 21H
    JMP GET_M

INPUT_DONE:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
INPUT_DATA_PROC ENDP


; =========================================================
; 2. 计算功能 1：单利计算 (Simple Interest)
; 公式: Interest = (Principal * Rate * Months) / 1200
; =========================================================
CALC_SIMPLE_INTEREST_PROC PROC
    PUSH AX
    PUSH BX
    PUSH DX

    ; AX = Principal * Rate
    MOV AX, principal
    MOV BX, rate
    MUL BX                ; DX:AX = P * R

    ; DX:AX = (P * R) * Months
    MOV BX, tenure_months
    MUL BX                ; DX:AX = P * R * M

    ; AX / 1200
    MOV BX, 1200
    DIV BX                ; 商在 AX 中

    MOV simple_interest, AX

    POP DX
    POP BX
    POP AX
    RET
CALC_SIMPLE_INTEREST_PROC ENDP


; =========================================================
; 3. 计算功能 2：到期总额计算 (Total Maturity Amount)
; 公式: Total = Principal + Simple Interest
; =========================================================
CALC_TOTAL_MATURITY_PROC PROC
    PUSH AX
    PUSH BX

    MOV AX, principal
    ADD AX, simple_interest
    MOV total_maturity, AX

    POP BX
    POP AX
    RET
CALC_TOTAL_MATURITY_PROC ENDP


; =========================================================
; 辅助工具：键盘读取数字 + 严格字符校验 (0-9)
; 返回: AX = 转换后的整数 (若非数字或回车直接输入则返 0)
; =========================================================
READ_NUM_VALIDATE PROC
    PUSH BX
    PUSH CX
    PUSH DX

    MOV BX, 0             ; 累加器清零

READ_CHAR_LOOP:
    MOV AH, 01H           ; 读取单个字符
    INT 21H

    CMP AL, 13            ; 按下 Enter 键？
    JE READ_FINISHED

    CMP AL, '0'           ; 小于 '0' 则非法
    JB READ_INVALID
    CMP AL, '9'           ; 大于 '9' 则非法
    JA READ_INVALID

    SUB AL, '0'           ; ASCII 转数字
    MOV CL, AL
    MOV CH, 0

    ; BX = BX * 10 + CX
    MOV AX, BX
    MOV DX, 10
    MUL DX
    ADD AX, CX
    MOV BX, AX
    JMP READ_CHAR_LOOP

READ_INVALID:
    MOV AX, 0
    JMP READ_EXIT

READ_FINISHED:
    MOV AX, BX

READ_EXIT:
    POP DX
    POP CX
    POP BX
    RET
READ_NUM_VALIDATE ENDP


; =========================================================
; 辅助工具：屏幕打印数字 (0-65535)
; =========================================================
M2_PRINT_NUM PROC
    PUSH AX
    PUSH BX
    PUSH CX
    PUSH DX

    MOV BX, 10
    MOV CX, 0

    CMP AX, 0
    JNE M2_CONVERT
    MOV DL, '0'
    MOV AH, 02H
    INT 21H
    JMP M2_DONE

M2_CONVERT:
M2_DIV_LOOP:
    MOV DX, 0
    DIV BX
    PUSH DX
    INC CX
    CMP AX, 0
    JNE M2_DIV_LOOP

M2_PRINT_LOOP:
    POP DX
    ADD DL, '0'
    MOV AH, 02H
    INT 21H
    LOOP M2_PRINT_LOOP

M2_DONE:
    POP DX
    POP CX
    POP BX
    POP AX
    RET
M2_PRINT_NUM ENDP

END MAIN
